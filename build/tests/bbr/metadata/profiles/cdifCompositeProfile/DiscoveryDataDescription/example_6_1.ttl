    cdi:statistic [ cdi:computationBase "ValidOnly" ;
            cdi:content -3.2e+00 ;
            cdi:isWeighted false ;
            cdi:typeOfNumericValue "decimal" ] ;
    cdif:typeOfStatistic [ a schema1:DefinedTerm ;
            schema1:name "Mean" ;
            schema1:termCode "mean" ] .

