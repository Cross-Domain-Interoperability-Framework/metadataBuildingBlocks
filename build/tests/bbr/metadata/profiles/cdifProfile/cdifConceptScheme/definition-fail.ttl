@prefix ex: <https://example.org/vocab/datatype/> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:date a skos:Concept ;
    skos:definition "A calendar date." ;
    skos:inScheme ex:datatypeScheme ;
    skos:notation "date" ;
    skos:prefLabel "Date" .

ex:float a skos:Concept ;
    skos:broader ex:numeric ;
    skos:definition "A floating-point numeric value." ;
    skos:inScheme ex:datatypeScheme ;
    skos:notation "float" ;
    skos:prefLabel "Float" .

ex:integer a skos:Concept ;
    skos:broader ex:numeric ;
    skos:definition "A whole number with no fractional part." ;
    skos:inScheme ex:datatypeScheme ;
    skos:notation "integer" ;
    skos:prefLabel "Integer" .

ex:text a skos:Concept ;
    skos:definition "A character string." ;
    skos:inScheme ex:datatypeScheme ;
    skos:notation "text" ;
    skos:prefLabel "Text" .

ex:numeric a skos:Concept ;
    skos:definition "A numeric value (integer or floating point)." ;
    skos:inScheme ex:datatypeScheme ;
    skos:narrower ex:float,
        ex:integer ;
    skos:notation "numeric" ;
    skos:prefLabel "Numeric" .

ex:datatypeScheme a skos:ConceptScheme ;
    schema1:version "1.0" ;
    skos:hasTopConcept ex:date,
        ex:numeric,
        ex:text ;
    skos:prefLabel "Example Physical Data Type Vocabulary" .

