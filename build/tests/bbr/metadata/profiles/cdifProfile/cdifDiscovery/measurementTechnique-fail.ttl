@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dataset/arctic-sea-ice-extent-2025> a schema1:Dataset ;
    schema1:dateModified "2025-06-15" ;
    schema1:identifier "https://doi.org/10.5281/zenodo.1234567" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:measurementTechnique 42 ;
    schema1:name "Arctic Sea Ice Extent Monthly Averages" ;
    schema1:spatialCoverage [ a schema1:Place ;
            schema1:geo [ a schema1:GeoShape ;
                    schema1:box "60 -180 90 180" ] ] ;
    schema1:subjectOf <https://example.org/metadata/arctic-sea-ice-extent-2025> ;
    schema1:temporalCoverage "1979-01-01/2025-06-30" ;
    schema1:url "https://example.org/dataset/arctic-sea-ice-extent" ;
    schema1:variableMeasured [ a schema1:PropertyValue ;
            schema1:name "sea ice extent" ;
            schema1:unitText "million km^2" ] ;
    dqv:hasQualityMeasurement [ a dqv:QualityMeasurement ;
            dqv:isMeasurementOf <https://www.w3.org/ns/dqv#Completeness> ;
            dqv:value "0.98" ] .

<https://example.org/metadata/arctic-sea-ice-extent-2025> a schema1:Dataset ;
    dcterms:conformsTo <https://w3id.org/cdif/core/1.1>,
        <https://w3id.org/cdif/discovery/1.1> ;
    schema1:about <https://example.org/dataset/arctic-sea-ice-extent-2025> ;
    schema1:additionalType dcat:CatalogRecord .

