@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema1: <http://schema.org/> .

<https://example.org/activity/icpms-run> a schema1:Action,
        prov:Activity ;
    schema1:instrument <https://example.org/instrument/icpms-01> ;
    schema1:name "ICP-MS run" .

<https://example.org/instrument/icpms-01> a schema1:Product ;
    schema1:additionalType <https://manual.nexusformat.org/classes/base_classes/NXinstrument.html> ;
    schema1:name "Example quadrupole ICP-MS" .

