@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdif: <https://w3id.org/cdif/> .

<https://example.org/vd/both-maximum-bounds> a cdif:SubstantiveValueDomain ;
    cdi:isDescribedBy <https://example.org/vacd/both-maximum-bounds> ;
    cdif:displayLabel "Upper limit stated twice" ;
    cdif:recommendedDataType "xsd:decimal" .

<https://example.org/vacd/both-maximum-bounds> a cdi:ValueAndConceptDescription ;
    cdi:classificationLevel "Continuous" ;
    cdi:description "Must fail: cdi:maximumValueInclusive and cdi:maximumValueExclusive both state the upper limit. Every other part of this instance is valid, so the bounds pair is the only reason it fails." ;
    cdi:maximumValueExclusive "60.1" ;
    cdi:maximumValueInclusive "60.0" .

