@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdif: <https://w3id.org/cdif/> .

<https://example.org/vd/both-minimum-bounds> a cdif:SentinelValueDomain ;
    cdi:isDescribedBy <https://example.org/vacd/both-minimum-bounds> ;
    cdif:displayLabel "Lower limit stated twice" ;
    cdif:recommendedDataType "xsd:integer" .

<https://example.org/vacd/both-minimum-bounds> a cdi:ValueAndConceptDescription ;
    cdi:classificationLevel "Interval" ;
    cdi:description "Must fail: cdi:minimumValueInclusive and cdi:minimumValueExclusive both state the lower limit. Carried on the sentinel branch so the pair is checked on both roots of the oneOf." ;
    cdi:minimumValueExclusive "-100" ;
    cdi:minimumValueInclusive "-99" .

