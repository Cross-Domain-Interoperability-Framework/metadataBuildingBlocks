@prefix cdif: <https://w3id.org/cdif/> .
@prefix schema1: <http://schema.org/> .

<ex:domain/unstated> a cdif:EnumerationDomain ;
    schema1:name "Sampling method" ;
    cdif:identifier [ a schema1:PropertyValue ;
            schema1:propertyID "ex:local" ;
            schema1:value "sampling-method" ] ;
    cdif:purpose "Records how each sample was collected." .

