@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdif: <https://w3id.org/cdif/> .

<https://example.org/struct/long/comp/varDescriptor> a cdi:VariableDescriptorComponent ;
    cdif:isDefinedBy_DescriptorVariable <https://example.org/struct/long/dv/measureName> ;
    cdif:isDefinedBy_Variable <https://example.org/struct/long/rv/somethingElse> .

<https://example.org/struct/long/dv/measureName> a cdi:DescriptorVariable ;
    cdif:hasValuesFrom <https://example.org/struct/long/dvd/measureName> ;
    cdif:name "measure_name" .

<https://example.org/struct/long/dvd/measureName> a cdi:DescriptorValueDomain ;
    cdif:takesValuesFrom [ cdif:isDefinedBy <https://example.org/struct/long/rv/systolicBP> ;
            cdif:value "systolic_bp" ] .

