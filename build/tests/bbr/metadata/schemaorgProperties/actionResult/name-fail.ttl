@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a schema1:DataDownload ;
    dcterms:conformsTo <https://example.org/schema/query-result> ;
    schema1:description "Per-request CSV representation returned by the dataset query API. The response is generated per request, so it carries no contentUrl or contentSize." ;
    schema1:encodingFormat "text/csv" ;
    schema1:name 42 .

