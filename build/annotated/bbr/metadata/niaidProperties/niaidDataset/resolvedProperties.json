ue"},{"path":["bios:developmentalStage","schema:minValue"],"id":"http://schema.org/minValue","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/minValue"},{"path":["bios:developmentalStage","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/name"},{"path":["bios:developmentalStage","schema:unitCode"],"id":"http://schema.org/unitCode","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/unitCode"},{"path":["bios:developmentalStage","schema:unitText"],"id":"http://schema.org/unitText","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/unitText"},{"path":["bios:developmentalStage","schema:value"],"id":"http://schema.org/value","schema_type":["number","string"],"sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/value"},{"path":["bios:environmentalSystem"],"id":"https://bioschemas.org/environmentalSystem","description":"The habitat or ecosystem where the sample was collected.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/environmentalSystem"},{"path":["bios:experimentalPurpose"],"id":"https://bioschemas.org/experimentalPurpose","description":"The planned or executed experimental procedures involving the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/experimentalPurpose"},{"path":["bios:isControl"],"id":"https://bioschemas.org/isControl","description":"Whether the sample is used as a normal control.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/isControl"},{"path":["bios:locationOfOrigin"],"id":"https://bioschemas.org/locationOfOrigin","description":"The location from which the sample was originally collected.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/locationOfOrigin"},{"path":["bios:project"],"id":"https://bioschemas.org/project","description":"The project the sample belongs to.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/project"},{"path":["bios:sampleAvailability"],"id":"https://bioschemas.org/sampleAvailability","description":"Whether the sample is available for reuse.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleAvailability"},{"path":["bios:sampleProcess"],"id":"https://bioschemas.org/sampleProcess","description":"The processing technique applied to the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleProcess"},{"path":["bios:sampleQuantity"],"id":"https://bioschemas.org/sampleQuantity","description":"The size of the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleQuantity"},{"path":["bios:sampleState"],"id":"https://bioschemas.org/sampleState","description":"The condition, composition or state of the sample, e.g. dried, frozen.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleState"},{"path":["bios:sampleStorageTemperature"],"id":"https://bioschemas.org/sampleStorageTemperature","description":"The temperature at which the sample is stored.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleStorageTemper