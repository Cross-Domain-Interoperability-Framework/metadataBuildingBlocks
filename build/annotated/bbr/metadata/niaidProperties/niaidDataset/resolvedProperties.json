 in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:topConceptOf"],"id":"http://www.w3.org/2004/02/skos/core#topConceptOf","description":"Concept scheme(s) for which this is a top concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#topConceptOf"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","description":"Concept scheme(s) this concept belongs to.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:editorialNote"],"id":"http://www.w3.org/2004/02/skos/core#editorialNote","description":"Note for editors and maintainers.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#editorialNote"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:changeNote"],"id":"http://www.w3.org/2004/02/skos/core#changeNote","description":"Note documenting a change.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#changeNote"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:historyNote"],"id":"http://www.w3.org/2004/02/skos/core#historyNote","description":"Note about past state or use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#historyNote"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:note"],"id":"http://www.w3.org/2004/02/skos/core#note","description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:scopeNote"],"id":"http://www.w3.org/2004/02/skos/core#scopeNote","description":"Note clarifying meaning and/or intended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funding","_anyOf","0","_anyOf","1","schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:includedInDataCatalog","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataCatalog"],"effectiveId":"http://schema.org/name"},{"path":["schema:includedInDataCatalog","schema:url"],"id":"http://schema.org/url","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataCatalog"],"effectiveId":"http://schema.org/url"},{"path":["schema:includedInDataCatalog","schema:archivedAt"],"id":"http://schema.org/archivedAt","description":"The dataset's page in this catalog.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataCatalog"],"effectiveId":"http://schema.org/archivedAt"},{"path":["schema:includedInDataCatalog","nde:versionDate"],"id":"https://discovery.biothings.io/ns/nde/versionDate","description":"The date of the version of the catalog the portal harvested.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataCatalog"],"effectiveId":"https://discovery.biothings.io/ns/nde/versionDate"},{"path":["nde:isBasisFor","nde:doi"],"id":"https://discovery.biothings.io/ns/nde/doi","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataset"],"effectiveId":"https://discovery.biothings.io/ns/nde/doi"},{"path":["nde:isBasisFor","nde:relationship"],"id":"https://discovery.biothings.io/ns/nde/relationship","description":"How the resource is related, e.g. \"has part\" or \"is part of\".","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataset"],"effectiveId":"https://discovery.biothings.io/ns/nde/relationship"},{"path":["nde:isBasisFor","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataset"],"effectiveId":"http://schema.org/name"},{"path":["schema:funding","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for a particular grant","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funding","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:funding","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:funding","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:funding","schema:description"],"id":"http://schema.org/description","description":"description of the funding or grant","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/description"},{"path":["schema:funding","schema:name"],"id":"http://schema.org/name","description":"title of the grant","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/name"},{"path":["schema:funding","schema:funder"],"id":"http://schema.org/funder","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/funder"},{"path":["schema:funding","schema:funder","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:funding","schema:funder","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"An email address or a contact web page (a form, an issue tracker), or both; at least one is required. Schema.org also allows telephone and postal contacts. A URL-only contact is ordinary in DCAT (a vcard:Kind with only vcard:hasURL), so requiring email made such records invalid.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["schema:funding","schema:funder","schema:contactPoint","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/url"},{"path":["schema:funding","schema:funder","schema:contactPoint","schema:email"],"id":"http://schema.org/email","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["schema:funding","schema:funder","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/affiliation"},{"path":["schema:funding","schema:funder","schema:affiliation","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:funding","schema:funder","schema:affiliation","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funding","schema:funder","schema:affiliation","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:funding","schema:funder","schema:affiliation","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known. A list when there are several; a single label may be a plain string, as JSON-LD framing writes a one-item list.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:funding","schema:funder","schema:affiliation","schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:funding","schema:funder","schema:affiliation","schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:funding","schema:funder","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known. A list when there are several; a single label may be a plain string, as JSON-LD framing writes a one-item list.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:funding","schema:funder","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funding","schema:funder","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["schema:funding","schema:funder","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"},{"path":["schema:funding","cdifniaid:projectNumSplit"],"id":"https://w3id.org/cdif/niaid/terms/projectNumSplit","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/projectNumSplit"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:applTypeCode"],"id":"https://w3id.org/cdif/niaid/terms/applTypeCode","description":"Application type, e.g. 5 for a non-competing continuation.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/applTypeCode"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:activityCode"],"id":"https://w3id.org/cdif/niaid/terms/activityCode","description":"Activity code, e.g. R01.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/activityCode"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:icCode"],"id":"https://w3id.org/cdif/niaid/terms/icCode","description":"The NIH institute or center, e.g. AI for NIAID.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/icCode"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:serialNum"],"id":"https://w3id.org/cdif/niaid/terms/serialNum","description":"Serial number of the grant.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/serialNum"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:supportYear"],"id":"https://w3id.org/cdif/niaid/terms/supportYear","description":"Year of support.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/supportYear"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:fullSupportYear"],"id":"https://w3id.org/cdif/niaid/terms/fullSupportYear","description":"Year of support with any suffix.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/fullSupportYear"},{"path":["schema:funding","cdifniaid:projectNumSplit","cdifniaid:suffixCode"],"id":"https://w3id.org/cdif/niaid/terms/suffixCode","description":"Suffix, e.g. S1 for a supplement.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidMonetaryGrant"],"effectiveId":"https://w3id.org/cdif/niaid/terms/suffixCode"},{"path":["schema:spatialCoverage","nde:administrativeType"],"id":"https://discovery.biothings.io/ns/nde/administrativeType","description":"The kind of administrative area, e.g. country.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidPlace"],"effectiveId":"https://discovery.biothings.io/ns/nde/administrativeType"},{"path":["schema:sourceOrganization","cdifniaid:correctionApproved"],"id":"https://w3id.org/cdif/niaid/terms/correctionApproved","description":"A correction to the portal's record of the project has been approved.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.niaidProperties.niaidDataset"],"effectiveId":"https://w3id.org/cdif/niaid/terms/correctionApproved"}]}