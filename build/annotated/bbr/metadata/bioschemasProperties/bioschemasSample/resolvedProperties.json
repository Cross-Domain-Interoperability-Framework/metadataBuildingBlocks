{"defs":{"0":[{"path":["schema:identifier"],"id":"http://schema.org/identifier","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:name"],"id":"http://schema.org/name","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/name"},{"path":["schema:termCode"],"id":"http://schema.org/termCode","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:url"],"id":"http://schema.org/url","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/url"}]},"properties":[{"path":["bios:anatomicalStructure"],"id":"https://bioschemas.org/anatomicalStructure","description":"The organ or tissue the sample was collected from.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/anatomicalStructure"},{"path":["bios:anatomicalSystem"],"id":"https://bioschemas.org/anatomicalSystem","description":"The anatomical system the sample was collected from, e.g. circulatory, digestive, immune.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/anatomicalSystem"},{"path":["bios:associatedPhenotype"],"id":"https://bioschemas.org/associatedPhenotype","description":"Defining characteristics expressed by the biological source of the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/associatedPhenotype"},{"path":["bios:collectionMethod"],"id":"https://bioschemas.org/collectionMethod","description":"Conditions and methods of acquisition of the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/collectionMethod"},{"path":["bios:collector"],"id":"https://bioschemas.org/collector","description":"The Person or Organization who collected the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/collector"},{"path":["bios:dateCollected"],"id":"https://bioschemas.org/dateCollected","description":"The date the sample was collected.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/dateCollected"},{"path":["bios:dateProcessed"],"id":"https://bioschemas.org/dateProcessed","description":"The date the sample was processed or used in a method.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/dateProcessed"},{"path":["bios:developmentalStage"],"id":"https://bioschemas.org/developmentalStage","description":"The age or developmental stage of the source when the sample was created, as a term or a quantity.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/developmentalStage"},{"path":["bios:environmentalSystem"],"id":"https://bioschemas.org/environmentalSystem","description":"The habitat or ecosystem where the sample was collected.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/environmentalSystem"},{"path":["bios:experimentalPurpose"],"id":"https://bioschemas.org/experimentalPurpose","description":"The planned or executed experimental procedures involving the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/experimentalPurpose"},{"path":["bios:isControl"],"id":"https://bioschemas.org/isControl","description":"Whether the sample is used as a normal control.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/isControl"},{"path":["bios:locationOfOrigin"],"id":"https://bioschemas.org/locationOfOrigin","description":"The location from which the sample was originally collected.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/locationOfOrigin"},{"path":["bios:sampleAvailability"],"id":"https://bioschemas.org/sampleAvailability","description":"Whether the sample is available for reuse.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleAvailability"},{"path":["bios:sampleProcess"],"id":"https://bioschemas.org/sampleProcess","description":"The processing technique applied to the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/sampleProcess"},{"path":["bios:sampleQuantity"],"id":"https://bioschemas.org/sampleQuantity","description":"The size of the sample.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleQuantity"},{"path":["bios:sampleState"],"id":"https://bioschemas.org/sampleState","description":"The condition, composition or state of the sample, e.g. dried, frozen.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/sampleState"},{"path":["bios:sampleStorageTemperature"],"id":"https://bioschemas.org/sampleStorageTemperature","description":"The temperature at which the sample is stored.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/sampleStorageTemperature"},{"path":["bios:sampleType"],"id":"https://bioschemas.org/sampleType","description":"The type of sample, intentionally broad (cells, rock, sand).","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/sampleType"},{"path":["bios:sex"],"id":"https://bioschemas.org/sex","description":"The biological sex of the individual the sample was obtained from.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/sex"},{"path":["bios:studyID"],"id":"https://bioschemas.org/studyID","description":"The identifier of the study the sample belongs to.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/studyID"},{"path":["bios:studyTitle"],"id":"https://bioschemas.org/studyTitle","description":"The title of the study the sample belongs to.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"https://bioschemas.org/studyTitle"},{"path":["bios:project"],"id":"https://bioschemas.org/project","description":"The project the sample belongs to.","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"ref":"0","effectiveId":"https://bioschemas.org/project"},{"path":["bios:collector","schema:name"],"id":"http://schema.org/name","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/name"},{"path":["bios:developmentalStage","schema:value"],"id":"http://schema.org/value","schema_type":["number","string"],"sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/value"},{"path":["bios:developmentalStage","schema:minValue"],"id":"http://schema.org/minValue","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/minValue"},{"path":["bios:developmentalStage","schema:maxValue"],"id":"http://schema.org/maxValue","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/maxValue"},{"path":["bios:developmentalStage","schema:unitText"],"id":"http://schema.org/unitText","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/unitText"},{"path":["bios:developmentalStage","schema:unitCode"],"id":"http://schema.org/unitCode","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/unitCode"},{"path":["bios:developmentalStage","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.bioschemasProperties.bioschemasSample"],"effectiveId":"http://schema.org/name"}]}