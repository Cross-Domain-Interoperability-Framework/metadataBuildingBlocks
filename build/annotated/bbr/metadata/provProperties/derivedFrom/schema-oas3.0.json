    "cdif.bbr.metadata.cdifDataType.cdifConceptOrTermOrString": {
      "title": "CDIF Concept-or-Term-or-String",
      "description": "Shared shape for a CDIF property that carries either a controlled-vocabulary value or a bare string label. Wraps cdifConceptOrTerm (SKOS-concept @id-ref, schema:DefinedTerm, or inline cdif:Concept) with a plain-string alternative used for legacy or single-word labels not yet bound to a vocabulary.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/provProperties/derivedFrom/schema-oas3.0.json#/x-defs/cdif.bbr.metadata.cdifDataType.cdifConceptOrTerm"
        }
      ],
      "x-schema-source": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/cdifDataType/cdifConceptOrTermOrString/schema.yaml",
      "x-schema-version": "https://json-schema.org/draft/2020-12/schema"
    },
    "cdif.bbr.metadata.cdifDataType.cdifConceptOrTerm": {
      "description": "A SKOS concept identified by URI, a schema:DefinedTerm, or an inline cdif:Concept. Shared shape used wherever a CDIF property carries either a controlled-vocabulary reference or an inline concept definition.",
      "anyOf": [
        {
          "description": "reference to a skos concept for the data type",
          "allOf": [
            {
              "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/provProperties/derivedFrom/schema-oas3.0.json#/x-defs/cdif.bbr.metadata.cdifDataType.objectReference_1"
