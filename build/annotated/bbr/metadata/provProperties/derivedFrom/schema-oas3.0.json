{
  "x-defs": {
    "cdif.bbr.metadata.cdifDataType.objectReference": {
      "title": "Object Reference",
      "description": "A reference to a node defined elsewhere, by its @id.",
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "description": "resolvable @id of the referenced node"
        }
      },
      "required": [
        "@id"
      ],
      "additionalProperties": false,
      "x-schema-source": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/cdifDataType/objectReference/schema.json",
      "x-schema-version": "https://json-schema.org/draft/2020-12/schema"
