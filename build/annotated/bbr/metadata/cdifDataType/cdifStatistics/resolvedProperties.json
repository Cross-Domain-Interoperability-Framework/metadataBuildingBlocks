{"defs":{"0":[{"path":["cdi:computationBase"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/computationBase","description":"The cases included in determining the statistic \u2014 Total (all cases, valid and missing), ValidOnly (valid values only), MissingOnly (invalid cases only).","schema_type":"string","enum":["MissingOnly","Total","ValidOnly"],"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/computationBase"},{"path":["cdi:content"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/content","description":"The value of the statistic expressed as a real number.","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/content"},{"path":["cdi:isWeighted"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isWeighted","description":"True if the statistic was computed using a weighting variable.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isWeighted"},{"path":["cdi:typeOfNumericValue"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfNumericValue","description":"The type of numeric value carried in cdi:content \u2014 decimal, float, or double.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfNumericValue"}]},"properties":[{"path":["_anyOf"],"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"keyword":"anyOf"},{"path":["_anyOf","0"],"title":"Statistics","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"keyword":"branch"},{"path":["_anyOf","0","cdi:typeOfStatistic"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfStatistic","description":"Controlled-vocabulary entry naming the kind of statistic \u2014 e.g. mean, median, count, sum, stdDev.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfStatistic"},{"path":["_anyOf","0","cdi:statistic"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/statistic","description":"Ordered list of Statistic value objects carried by this bundle. Order is significant \u2014 consumers MAY rely on array position.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"ref":"0","effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/statistic"},{"path":["_anyOf","0","cdi:hasWeight"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight","description":"The InstanceVariable whose values were used as weights when computing the Statistic entries (inline cdifInstanceVariable node or an @id-reference).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight"},{"path":["_anyOf","0","cdif:appliesTo"],"id":"https://w3id.org/cdif/appliesTo","description":"CDIF addition (not in canonical DDI-CDI): the InstanceVariable(s) this Statistics bundle summarizes \u2014 the per-bundle \"what these numbers describe\" link. Used **only** when this Statistics bundle sits inside a StatisticsCollection that indexes more than one variable, to disambiguate which variable each bundle describes. It MUST NOT appear on a Statistics bundle attached at Dataset level via `cdif:statistics`; per-variable stats belong under `schema:variableMeasured[i].cdif:isDescribedBy_StatisticsCollection` (the direct JSON mapping of the DDI-CDI `InstanceVariable.isDescribedBy` association).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/appliesTo"},{"path":["_anyOf","0","cdif: