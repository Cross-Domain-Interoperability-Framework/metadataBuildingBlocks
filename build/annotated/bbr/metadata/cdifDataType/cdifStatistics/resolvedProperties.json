,"effectiveId":"https://w3id.org/cdif/displayLabel"},{"path":["_anyOf","0","cdif:has_CategoryStatistics","cdi:for","cdif:definition"],"id":"https://w3id.org/cdif/definition","description":"Natural-language definition of the category. CDIF-simplified from DDI-CDI Category.definition (InternationalString).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/definition"},{"path":["_anyOf","0","cdif:has_CategoryStatistics","cdi:for","cdif:descriptiveText"],"id":"https://w3id.org/cdif/descriptiveText","description":"Short natural-language account of the category. CDIF-simplified from DDI-CDI Category.descriptiveText (InternationalString).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/descriptiveText"},{"path":["_anyOf","0","cdif:has_CategoryStatistics","cdi:for","cdif:name"],"id":"https://w3id.org/cdif/name","description":"Human-understandable name(s). CDIF-simplified from DDI-CDI Category.name (ObjectName) to plain strings.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/name"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2"],"title":"a","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"],"keyword":"branch"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:narrower"],"description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:broader"],"description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:inScheme"],"description":"Concept scheme(s) this concept belongs to.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:note"],"description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:definition"],"description":"Formal explanation of the meaning of this concept.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:notation"],"description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","2","skos:prefLabel"],"description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"Name for the controlled vocabulary responsible for this keyword.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["_anyOf","0","cdi:typeOfStatistic","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path"