                        "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/cdifDataType/cdifConceptOrTermOrString/schema-oas3.0.json#/x-defs/cdif.bbr.metadata.skosProperties.skosConcept/$defs/LanguageTaggedValue"
                      }
                    ]
                  }
                }
              ],
              "x-jsonld-id": "http://www.w3.org/2004/02/skos/core#changeNote"
