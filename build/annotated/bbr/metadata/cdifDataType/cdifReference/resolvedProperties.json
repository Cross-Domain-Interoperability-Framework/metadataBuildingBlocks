{"defs":{},"properties":[{"path":["schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/name"},{"path":["schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/description"},{"path":["schema:url"],"id":"http://schema.org/url","required":true,"schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/url"},{"path":["dcat:hadRole"],"id":"http://www.w3.org/ns/dcat#hadRole","description":"Role of the related resource as a SKOS Concept (DCAT canonical role slot).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifReference"],"effectiveId":"http://www.w3.org/ns/dcat#hadRole"},{"path":["dcterms:relation"],"id":"http://purl.org/dc/terms/relation","description":"URI of the related resource (DCAT canonical pointer to what is being related to; distinct from schema:url which is the presentation URL inherited from labeledLink).","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifReference"],"effectiveId":"http://purl.org/dc/terms/relation"},{"path":["dcat:hadRole","_anyOf","2"],"title":"a","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"],"keyword":"branch"},{"path":["dcat:hadRole","_anyOf","2","skos:narrower"],"description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","2","skos:broader"],"description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","2","skos:inScheme"],"description":"Concept scheme(s) this concept belongs to.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","2","skos:note"],"description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","2","skos:definition"],"description":"Formal explanation of the meaning of this concept.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","2","skos:notation"],"description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","2","skos:prefLabel"],"description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["dcat:hadRole","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["dcat:hadRole","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"Name for the controlled vocabulary responsible for this keyword.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["dcat:hadRole","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["dcat:hadRole","_anyOf","1","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["dcat:hadRole","_anyOf","1","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["dcat:hadRole","_anyOf","1","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["dcat:hadRole","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"}]}