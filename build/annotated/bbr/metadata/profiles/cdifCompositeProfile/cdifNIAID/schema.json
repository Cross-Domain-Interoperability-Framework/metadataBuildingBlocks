{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "CDIF NIAID profile",
  "description": "CDIF profile for dataset records from the NIAID Data Discovery Portal. Composes cdifCore with niaidDataset, which constrains the NIAID (nde:), Bioschemas (bios:) and cdifniaid: properties those records carry. cdifDiscovery is not composed: about one record in six from the portal has no discovery content, so a record that has it claims and is validated against cdifDiscovery as well, as its own conformsTo entry.",
  "allOf": [
    {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/profiles/cdifProfile/cdifCore/schema.json"
    },
    {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/niaidProperties/niaidDataset/schema.json"
    }
  ],
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "cdif": "https://w3id.org/cdif/",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "prov": "http://www.w3.org/ns/prov#",
    "nde": "https://discovery.biothings.io/ns/nde/",
    "bios": "https://bioschemas.org/",
    "cdifniaid": "https://w3id.org/cdif/niaid/terms/"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "cdif.bbr.metadata.profiles.cdifCompositeProfile.cdifNIAID",
    "register": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/register.json",
    "version": "1.0",
    "dateOfLastChange": "2026-11-13"
  }
}