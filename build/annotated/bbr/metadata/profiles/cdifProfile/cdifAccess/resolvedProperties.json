ntended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement"],"id":"http://www.w3.org/ns/odrl/2/refinement","description":"Constraints selecting the members of odrl:source that belong to this collection.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAsset"],"effectiveId":"http://www.w3.org/ns/odrl/2/refinement"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"anyOf"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","1"],"title":"b","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"branch"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","1","odrl:andSequence"],"id":"http://www.w3.org/ns/odrl/2/andSequence","description":"All of the constraints must be satisfied, in order.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/andSequence"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","1","odrl:xone"],"id":"http://www.w3.org/ns/odrl/2/xone","description":"Exactly one of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/xone"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","1","odrl:or"],"id":"http://www.w3.org/ns/odrl/2/or","description":"At least one of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/or"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","1","odrl:and"],"id":"http://www.w3.org/ns/odrl/2/and","description":"All of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/and"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"branch"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:status"],"id":"http://www.w3.org/ns/odrl/2/status","description":"The current value of the left operand, for comparison with the right operand.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/status"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:unit"],"id":"http://www.w3.org/ns/odrl/2/unit","description":"Unit of the right operand, e.g. a currency or unit of measure.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/unit"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:dataType"],"id":"http://www.w3.org/ns/odrl/2/dataType","description":"Datatype of the right operand, e.g. xsd:decimal.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/dataType"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:rightOperandReference"],"id":"http://www.w3.org/ns/odrl/2/rightOperandReference","description":"An IRI whose dereferenced value is the right operand.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/rightOperandReference"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:rightOperand"],"id":"http://www.w3.org/ns/odrl/2/rightOperand","description":"A literal, a value object ({\"@value\", \"@type\"}) or an {@id} reference.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/rightOperand"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:operator"],"id":"http://www.w3.org/ns/odrl/2/operator","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/operator"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:refinement","_anyOf","0","odrl:leftOperand"],"id":"http://www.w3.org/ns/odrl/2/leftOperand","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/leftOperand"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","1","odrl:source"],"id":"http://www.w3.org/ns/odrl/2/source","description":"The collection this one is drawn from.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAsset"],"effectiveId":"http://www.w3.org/ns/odrl/2/source"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAsset"],"keyword":"branch"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:target","_anyOf","0","odrl:partOf"],"id":"http://www.w3.org/ns/odrl/2/partOf","description":"AssetCollections this asset is a member of.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAsset"],"effectiveId":"http://www.w3.org/ns/odrl/2/partOf"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","odrl:refinement"],"id":"http://www.w3.org/ns/odrl/2/refinement","description":"Constraints selecting the members of odrl:source that belong to this collection.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"effectiveId":"http://www.w3.org/ns/odrl/2/refinement"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","1","odrl:source"],"id":"http://www.w3.org/ns/odrl/2/source","description":"The collection this one is drawn from.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"effectiveId":"http://www.w3.org/ns/odrl/2/source"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"keyword":"branch"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"keyword":"then"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"An email address or a contact web page (a form, an issue tracker), or both; at least one is required. Schema.org also allows telephone and postal contacts. A URL-only contact is ordinary in DCAT (a vcard:Kind with only vcard:hasURL), so requiring email made such records invalid.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:contactPoint","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/url"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:contactPoint","schema:email"],"id":"http://schema.org/email","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/affiliation"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation","schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:affiliation","schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["schema:distribution","odrl:hasPolicy","_anyOf","1","odrl:assigner","_anyOf","0","_then","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"},{"path":["schema:distribution","odrl:hasPolicy","odrl:obligation"],"id":"http://www.w3.org/ns/odrl/2/obligation","description":"Actions every user of the target must perform (range odrl:Duty), e.g. destroy the data at the end of a project. The spreadsheet gives 1..*; drafted as 0..* because an Offer with only permissions is common. OPEN: confirm.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/obligation"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition"],"id":"http://www.w3.org/ns/odrl/2/prohibition","description":"Actions a user must not perform (range odrl:Prohibition), e.g. share TRE credentials.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/prohibition"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:constraint"],"id":"http://www.w3.org/ns/odrl/2/constraint","description":"Conditions under which the prohibition applies (range odrl:Constraint).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/constraint"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:assignee"],"id":"http://www.w3.org/ns/odrl/2/assignee","description":"Who the prohibition applies to (range odrl:Party).","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/assignee"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:assigner"],"id":"http://www.w3.org/ns/odrl/2/assigner","description":"Party issuing this prohibition, if not given at policy level (range odrl:Party).","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/assigner"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:action"],"id":"http://www.w3.org/ns/odrl/2/action","description":"The prohibited action (range odrl:Action).","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/action"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:output"],"id":"http://www.w3.org/ns/odrl/2/output","description":"An asset created by exercising the action (range odrl:Asset).","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/output"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:target"],"id":"http://www.w3.org/ns/odrl/2/target","description":"The asset (range odrl:Asset).","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/target"},{"path":["schema:distribution","odrl:hasPolicy","odrl:prohibition","odrl:remedy"],"id":"http://www.w3.org/ns/odrl/2/remedy","description":"Duties owed if the prohibition is infringed.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/remedy"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission"],"id":"http://www.w3.org/ns/odrl/2/permission","description":"Actions a user may perform on the target (usage conditions).","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/permission"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty"],"id":"http://www.w3.org/ns/odrl/2/duty","description":"Duties that must be fulfilled before the permission can be exercised.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/duty"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty","odrl:constraint"],"id":"http://www.w3.org/ns/odrl/2/constraint","description":"Must include the accessConditionMarker (range odrl:Constraint).","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/constraint"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty","odrl:constraint","odrl:rightOperand"],"id":"http://www.w3.org/ns/odrl/2/rightOperand","required":true,"schema_type":"object","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/rightOperand"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty","odrl:constraint","odrl:operator"],"id":"http://www.w3.org/ns/odrl/2/operator","required":true,"schema_type":"object","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/operator"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty","odrl:constraint","odrl:leftOperand"],"id":"http://www.w3.org/ns/odrl/2/leftOperand","required":true,"schema_type":"object","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/leftOperand"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty","odrl:action"],"id":"http://www.w3.org/ns/odrl/2/action","description":"The action to complete first, e.g. cdifa1:assent (range odrl:Action).","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/action"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:duty","odrl:consequence"],"id":"http://www.w3.org/ns/odrl/2/consequence","description":"Further duties owed if this duty is not fulfilled.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule"],"effectiveId":"http://www.w3.org/ns/odrl/2/consequence"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:constraint"],"id":"http://www.w3.org/ns/odrl/2/constraint","description":"Conditions on exercising the permission (range odrl:Constraint), e.g. only users located in the UK (the spreadsheet's way of scoping users; see odrl:assignee).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/constraint"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:assignee"],"id":"http://www.w3.org/ns/odrl/2/assignee","description":"Who may exercise the permission (range odrl:Party), as a party or a (refined) PartyCollection, e.g. registered users located in the UK. This is the book's form; the spreadsheet scopes users with odrl:constraint instead. OPEN: settle on one, or say when each is used.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/assignee"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:assigner"],"id":"http://www.w3.org/ns/odrl/2/assigner","description":"Party granting this permission, if not given at policy level (range odrl:Party).","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/assigner"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:action"],"id":"http://www.w3.org/ns/odrl/2/action","description":"The permitted action (range odrl:Action). OPEN: the cdifa1 action vocabulary is not defined, so values are not enumerated; whether it is an ODRL profile or a standalone controlled vocabulary is still to be settled.","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/action"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:action","rdf:value"],"id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAction"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:action","odrl:refinement"],"id":"http://www.w3.org/ns/odrl/2/refinement","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAction"],"effectiveId":"http://www.w3.org/ns/odrl/2/refinement"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:output"],"id":"http://www.w3.org/ns/odrl/2/output","description":"An asset created by exercising the action, e.g. the result of odrl:derive.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/output"},{"path":["schema:distribution","odrl:hasPolicy","odrl:permission","odrl:target"],"id":"http://www.w3.org/ns/odrl/2/target","description":"The asset, normally a distribution or data service (range odrl:Asset).","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlRule","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/target"},{"path":["schema:distribution","odrl:hasPolicy","odrl:assignee"],"id":"http://www.w3.org/ns/odrl/2/assignee","description":"Party all rules apply to, if given once at policy level (range odrl:Party).","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/assignee"},{"path":["schema:distribution","odrl:hasPolicy","odrl:assigner"],"id":"http://www.w3.org/ns/odrl/2/assigner","description":"The party issuing the Offer, normally the repository or data custodian, given once at policy level (range odrl:Party). ODRL also accepts an assigner on every rule instead; CDIF asks for the policy-level form. The spreadsheet does not list an assigner yet.","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/assigner"},{"path":["schema:distribution","odrl:hasPolicy","odrl:target"],"id":"http://www.w3.org/ns/odrl/2/target","description":"Asset all rules apply to, if given once at policy level (range odrl:Asset).","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/target"},{"path":["schema:distribution","odrl:hasPolicy","odrl:conflict"],"id":"http://www.w3.org/ns/odrl/2/conflict","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy"],"effectiveId":"http://www.w3.org/ns/odrl/2/conflict"},{"path":["schema:distribution","odrl:hasPolicy","odrl:inheritFrom"],"id":"http://www.w3.org/ns/odrl/2/inheritFrom","description":"Parent policies whose rules this policy inherits.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy"],"effectiveId":"http://www.w3.org/ns/odrl/2/inheritFrom"},{"path":["schema:distribution","odrl:hasPolicy","odrl:profile"],"id":"http://www.w3.org/ns/odrl/2/profile","description":"ODRL profiles the policy conforms to.","required":true,"schema_type":"object","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy","bblocks://cdif.bbr.metadata.odrlProperties.odrlOffer"],"effectiveId":"http://www.w3.org/ns/odrl/2/profile"},{"path":["schema:distribution","odrl:hasPolicy","_then"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy"],"keyword":"then"},{"path":["schema:distribution","odrl:hasPolicy","_then","odrl:permission"],"id":"http://www.w3.org/ns/odrl/2/permission","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy"],"effectiveId":"http://www.w3.org/ns/odrl/2/permission"},{"path":["schema:distribution","odrl:hasPolicy","_then","odrl:prohibition"],"id":"http://www.w3.org/ns/odrl/2/prohibition","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy"],"effectiveId":"http://www.w3.org/ns/odrl/2/prohibition"},{"path":["schema:distribution","odrl:hasPolicy","_then","odrl:obligation"],"id":"http://www.w3.org/ns/odrl/2/obligation","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlPolicy"],"effectiveId":"http://www.w3.org/ns/odrl/2/obligation"}]}