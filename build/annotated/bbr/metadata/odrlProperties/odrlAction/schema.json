{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODRL Action",
  "description": "An ODRL 2.2 Action (https://www.w3.org/TR/odrl-model/#action) as used in a rule: either a reference to the action ({\"@id\": \"odrl:use\"}), or, when the action itself is narrowed, an object holding the action in rdf:value plus odrl:refinement constraints (e.g. print, at most 1200 dpi). Actions are open IRIs (odrlTerms), so ODRL profile actions validate.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "object",
      "description": "JSON-LD namespace prefixes for ODRL properties.",
      "properties": {
        "odrl": {
          "const": "http://www.w3.org/ns/odrl/2/"
        },
        "rdf": {
          "const": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/odrlProperties/odrlTerms/schema.json#/$defs/Action"
    },
    {
      "$ref": "#/$defs/RefinedAction"
    }
  ],
  "$defs": {
    "RefinedAction": {
      "type": "object",
      "properties": {
        "rdf:value": {
          "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/odrlProperties/odrlTerms/schema.json#/$defs/Action",
          "x-jsonld-id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#value"
        },
        "odrl:refinement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/odrlProperties/odrlConstraint/schema.json"
          },
          "x-jsonld-id": "http://www.w3.org/ns/odrl/2/refinement"
        }
      },
      "required": [
        "rdf:value",
        "odrl:refinement"
      ]
    }
  },
  "x-jsonld-prefixes": {
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "cdif.bbr.metadata.odrlProperties.odrlAction",
    "register": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-10-27"
  }
}