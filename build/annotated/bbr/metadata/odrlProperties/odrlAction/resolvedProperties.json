{"defs":{},"properties":[{"path":["odrl:refinement"],"id":"http://www.w3.org/ns/odrl/2/refinement","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlAction"],"effectiveId":"http://www.w3.org/ns/odrl/2/refinement"},{"path":["odrl:refinement","_anyOf"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"anyOf"},{"path":["odrl:refinement","_anyOf","1"],"title":"b","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"branch"},{"path":["odrl:refinement","_anyOf","1","odrl:andSequence"],"id":"http://www.w3.org/ns/odrl/2/andSequence","description":"All of the constraints must be satisfied, in order.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/andSequence"},{"path":["odrl:refinement","_anyOf","1","odrl:xone"],"id":"http://www.w3.org/ns/odrl/2/xone","description":"Exactly one of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/xone"},{"path":["odrl:refinement","_anyOf","1","odrl:or"],"id":"http://www.w3.org/ns/odrl/2/or","description":"At least one of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/or"},{"path":["odrl:refinement","_anyOf","1","odrl:and"],"id":"http://www.w3.org/ns/odrl/2/and","description":"All of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/and"},{"path":["odrl:refinement","_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"branch"},{"path":["odrl:refinement","_anyOf","0","odrl:status"],"id":"http://www.w3.org/ns/odrl/2/status","description":"The current value of the left operand, for comparison with the right operand."