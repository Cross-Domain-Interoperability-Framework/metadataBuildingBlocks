{"defs":{"0":[{"path":["schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"}]},"properties":[{"path":["_anyOf"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"keyword":"anyOf"},{"path":["_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"keyword":"branch"},{"path":["_anyOf","0","_then"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"keyword":"then","ref":"0"},{"path":["_anyOf","0","_then","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"},{"path":["_anyOf","0","_then","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["_anyOf","0","_then","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["_anyOf","0","_then","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["_anyOf","0","_then","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"ref":"0","effectiveId":"http://schema.org/affiliation"},{"path":["_anyOf","0","_then","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"An email address or a contact web page (a form, an issue tracker), or both; at least one is required. Schema.org also allows telephone and postal contacts. A URL-only contact is ordinary in DCAT (a vcard:Kind with only vcard:hasURL), so requiring email made such records invalid.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["_anyOf","0","_then","schema:contactPoint","schema:email"],"id":"http://schema.org/email","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["_anyOf","0","_then","schema:contactPoint","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/url"},{"path":["_anyOf","0","_then","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["_anyOf","1"],"title":"b","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"keyword":"branch"},{"path":["_anyOf","1","odrl:source"],"id":"http://www.w3.org/ns/odrl/2/source","description":"The collection this one is drawn from.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"effectiveId":"http://www.w3.org/ns/odrl/2/source"},{"path":["_anyOf","1","odrl:refinement"],"id":"http://www.w3.org/ns/odrl/2/refinement","description":"Constraints selecting the members of odrl:source that belong to this collection.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlParty"],"effectiveId":"http://www.w3.org/ns/odrl/2/refinement"},{"path":["_anyOf","1","odrl:refinement","_anyOf"],"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"anyOf"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"branch"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:leftOperand"],"id":"http://www.w3.org/ns/odrl/2/leftOperand","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/leftOperand"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:operator"],"id":"http://www.w3.org/ns/odrl/2/operator","required":true,"sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/operator"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:rightOperand"],"id":"http://www.w3.org/ns/odrl/2/rightOperand","description":"A literal, a value object ({\"@value\", \"@type\"}) or an {@id} reference.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/rightOperand"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:rightOperandReference"],"id":"http://www.w3.org/ns/odrl/2/rightOperandReference","description":"An IRI whose dereferenced value is the right operand.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/rightOperandReference"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:dataType"],"id":"http://www.w3.org/ns/odrl/2/dataType","description":"Datatype of the right operand, e.g. xsd:decimal.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/dataType"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:unit"],"id":"http://www.w3.org/ns/odrl/2/unit","description":"Unit of the right operand, e.g. a currency or unit of measure.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/unit"},{"path":["_anyOf","1","odrl:refinement","_anyOf","0","odrl:status"],"id":"http://www.w3.org/ns/odrl/2/status","description":"The current value of the left operand, for comparison with the right operand.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/status"},{"path":["_anyOf","1","odrl:refinement","_anyOf","1"],"title":"b","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"keyword":"branch"},{"path":["_anyOf","1","odrl:refinement","_anyOf","1","odrl:and"],"id":"http://www.w3.org/ns/odrl/2/and","description":"All of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/and"},{"path":["_anyOf","1","odrl:refinement","_anyOf","1","odrl:or"],"id":"http://www.w3.org/ns/odrl/2/or","description":"At least one of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/or"},{"path":["_anyOf","1","odrl:refinement","_anyOf","1","odrl:xone"],"id":"http://www.w3.org/ns/odrl/2/xone","description":"Exactly one of the constraints must be satisfied.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/xone"},{"path":["_anyOf","1","odrl:refinement","_anyOf","1","odrl:andSequence"],"id":"http://www.w3.org/ns/odrl/2/andSequence","description":"All of the constraints must be satisfied, in order.","sources":["bblocks://cdif.bbr.metadata.odrlProperties.odrlConstraint"],"effectiveId":"http://www.w3.org/ns/odrl/2/andSequence"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2"],"title":"a","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"keyword":"branch"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:narrower"],"id":"http://www.w3.org/2004/02/skos/core#narrower","description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#narrower"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:broader"],"id":"http://www.w3.org/2004/02/skos/core#broader","description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:topConceptOf"],"id":"http://www.w3.org/2004/02/skos/core#topConceptOf","description":"Concept scheme(s) for which this is a top concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#topConceptOf"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","description":"Concept scheme(s) this concept belongs to.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:editorialNote"],"id":"http://www.w3.org/2004/02/skos/core#editorialNote","description":"Note for editors and maintainers.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#editorialNote"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:changeNote"],"id":"http://www.w3.org/2004/02/skos/core#changeNote","description":"Note documenting a change.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#changeNote"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:historyNote"],"id":"http://www.w3.org/2004/02/skos/core#historyNote","description":"Note about past state or use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#historyNote"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:note"],"id":"http://www.w3.org/2004/02/skos/core#note","description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:scopeNote"],"id":"http://www.w3.org/2004/02/skos/core#scopeNote","description":"Note clarifying meaning and/or intended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","2","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["_anyOf","0","_then","schema:affiliation","schema:additionalType","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["_anyOf","0","_then","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["_anyOf","0","_then","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["_anyOf","0","_then","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"}]}