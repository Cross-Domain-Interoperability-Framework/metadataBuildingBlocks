{"defs":{"0":[{"path":["skos:broader"],"description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["skos:definition"],"description":"Formal explanation of the meaning of this concept.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["skos:inScheme"],"description":"Concept scheme(s) this concept belongs to.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["skos:narrower"],"description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["skos:notation"],"description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["skos:note"],"description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]},{"path":["skos:prefLabel"],"description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.profiles.cdifProfile.cdifConceptScheme"]}],"1":[{"path":["schema:name"],"id":"http://schema.org/name","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/name"},{"path":["schema:propertyID"],"id":"http://schema.org/propertyID","description":"identifier or name for the property concept quantified by the values in this variable slot. Multiple values can specify the property at different levels of granularity.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty","bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:unitCode"],"id":"http://schema.org/unitCode","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/unitCode"},{"path":["schema:unitText"],"id":"http://schema.org/unitText","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/unitText"},{"path":["schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/value"}]},"properties":[{"path":["schema:variableMeasured"],"id":"http://schema.org/variableMeasured","description":"Optional XAS data-array variables (energy, i0, itrans, ifluor, irefer, mutrans, mufluor, murefer, normtrans, normfluor, normrefer, chi, chi_re, chi_im, chi_mag, chi_pha, k, r, angle), each a cdi:InstanceVariable / schema:PropertyValue. Not required. The XDI variable propertyID enum is layered on in xasCore; this profile only enforces the base cdifInstanceVariable shape.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://schema.org/variableMeasured"},{"path":["schema:variableMeasured","schema:name"],"id":"http://schema.org/name","description":"string label associated with the variable in the dataset serialization","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/name"},{"path":["schema:variableMeasured","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/description"},{"path":["schema:variableMeasured","schema:alternateName"],"id":"http://schema.org/alternateName","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:variableMeasured","schema:measurementTechnique"],"id":"http://schema.org/measurementTechnique","description":"Text description or URI specifying how values for the variable were obtained.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/measurementTechnique"},{"path":["schema:variableMeasured","schema:propertyID"],"id":"http://schema.org/propertyID","description":"identifier or name for the property concept","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:variableMeasured","schema:unitText"],"id":"http://schema.org/unitText","description":"unit of measurement as text","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/unitText"},{"path":["schema:variableMeasured","schema:unitCode"],"id":"http://schema.org/unitCode","description":"URI or code identifying the unit of measure","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/unitCode"},{"path":["schema:variableMeasured","schema:minValue"],"id":"http://schema.org/minValue","description":"minimum numeric value in the dataset","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/minValue"},{"path":["schema:variableMeasured","schema:maxValue"],"id":"http://schema.org/maxValue","description":"maximum numeric value in the dataset","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/maxValue"},{"path":["schema:variableMeasured","schema:url"],"id":"http://schema.org/url","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.variableMeasured"],"effectiveId":"http://schema.org/url"},{"path":["schema:variableMeasured","cdif:physicalDataType"],"id":"https://w3id.org/cdif/physicalDataType","description":"identifier or name for the data type concept.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"ref":"0","effectiveId":"https://w3id.org/cdif/physicalDataType"},{"path":["schema:variableMeasured","cdif:role"],"id":"https://w3id.org/cdif/role","description":"Specifies the role this variable plays in a data structure. UnitIdentifier names the unit a row describes; Measure holds observed/derived values; Attribute qualifies an observation; Dimension addresses a cell in a multi-dimensional cube; Descriptor names the variable that a Reference column records values for (long format); ReferenceVariable holds those recorded values.","schema_type":"string","enum":["UnitIdentifier","Measure","Attribute","Dimension","Descriptor","ReferenceVariable"],"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"effectiveId":"https://w3id.org/cdif/role"},{"path":["schema:variableMeasured","cdif:simpleUnitOfMeasure"],"id":"https://w3id.org/cdif/simpleUnitOfMeasure","description":"The unit in which the data values are measured (kg, pound, euro), expressed as a simple string, in cases where no additional information is available (in the legacy system) or needed (as in the case of broad agreement within the community of use [i.e., ISO country codes, currencies, etc. in SDMX])","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"effectiveId":"https://w3id.org/cdif/simpleUnitOfMeasure"},{"path":["schema:variableMeasured","cdif:uses"],"id":"https://w3id.org/cdif/uses","description":"Essentially the same as schema:propertyID. References to concepts that this variable measures or represents. When the dataset's distribution carries cdi:isStructuredBy (CDIF Data Structure profile), cdif:uses references the RepresentedVariable that supplies the represented-variable-level properties below, which are then NOT duplicated on the InstanceVariable.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"ref":"0","effectiveId":"https://w3id.org/cdif/uses"},{"path":["schema:variableMeasured","cdi:function"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/function","description":"Immutable characteristic of the variable such as geographic designator, weight, temporal designation, etc. (InstanceVariable.function).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"ref":"0","effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/function"},{"path":["schema:variableMeasured","cdi:platformType"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/platformType","description":"The application or technical system context in which the variable has been realized - typically a statistical processing package or processing environment (InstanceVariable.platformType).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"ref":"0","effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/platformType"},{"path":["schema:variableMeasured","cdi:source"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/source","description":"Reference capturing provenance information for this InstanceVariable (InstanceVariable.source).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/source"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection"],"id":"https://w3id.org/cdif/isDescribedBy_StatisticsCollection","description":"The StatisticsCollection holding summary / category statistics for this InstanceVariable (direct JSON mapping of the DDI-CDI `InstanceVariable.isDescribedBy \u2192 StatisticsCollection` association). cdif: namespaced and target-suffixed because the DDI-CDI isDescribedBy association is polymorphic. This is the canonical CDIF path for **per-variable** statistics; dataset-scope aggregates (row count etc.) go under `Dataset.cdif:statistics` instead.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"effectiveId":"https://w3id.org/cdif/isDescribedBy_StatisticsCollection"},{"path":["schema:variableMeasured","cdi:describedUnitOfMeasure"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/describedUnitOfMeasure","description":"The unit in which the data values are measured, expressed as a controlled-vocabulary entry (RepresentedVariable.describedUnitOfMeasure). For a plain-string unit, use cdif:simpleUnitOfMeasure instead.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/describedUnitOfMeasure"},{"path":["schema:variableMeasured","cdi:qualifies"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/qualifies","description":"reference to an instance variable defined for this dataset","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifInstanceVariable"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/qualifies"},{"path":["prov:wasGeneratedBy"],"id":"http://www.w3.org/ns/prov#wasGeneratedBy","description":"Optional-vocabulary layer on the XAS analysis activity. Adds propertyID enums for (a) activity-level additionalProperty entries, (b) the sample (schema:object) additionalProperty entries, and (c) the beamline peer instrument's additionalProperty entries. Enum arms are additive over the base propertyID_item shape.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://www.w3.org/ns/prov#wasGeneratedBy"},{"path":["prov:wasGeneratedBy","schema:additionalProperty"],"id":"http://schema.org/additionalProperty","description":"XAS activity-level additionalProperty vocabulary. All entries resolve to SKOS concepts in the XAS-CDIF glossary.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"ref":"1","effectiveId":"http://schema.org/additionalProperty"},{"path":["prov:wasGeneratedBy","schema:object"],"id":"http://schema.org/object","description":"Sample additionalProperty entries. XDI Sample.* vocabulary (XDI-CDIF-Mapping.xlsx rows 47-64) plus legacy xas:* names and NEXUS NXsample fields.","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://schema.org/object"},{"path":["prov:wasGeneratedBy","schema:object","schema:additionalProperty"],"id":"http://schema.org/additionalProperty","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"ref":"1","effectiveId":"http://schema.org/additionalProperty"},{"path":["prov:wasGeneratedBy","schema:object","schema:additionalProperty","schema:propertyID"],"id":"http://schema.org/propertyID","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://schema.org/propertyID"},{"path":["prov:wasGeneratedBy","prov:used"],"id":"http://www.w3.org/ns/prov#used","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://www.w3.org/ns/prov#used"},{"path":["prov:wasGeneratedBy","prov:used","_then"],"sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"keyword":"then"},{"path":["prov:wasGeneratedBy","prov:used","_then","schema:instrument"],"id":"http://schema.org/instrument","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://schema.org/instrument"},{"path":["prov:wasGeneratedBy","prov:used","_then","schema:instrument","schema:additionalProperty"],"id":"http://schema.org/additionalProperty","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"ref":"1","effectiveId":"http://schema.org/additionalProperty"},{"path":["prov:wasGeneratedBy","prov:used","_then","schema:instrument","schema:additionalProperty","schema:propertyID"],"id":"http://schema.org/propertyID","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.xasProperties.xasOptional"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"Name for the controlled vocabulary responsible for this keyword.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:variableMeasured","schema:measurementTechnique","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:variableMeasured","schema:url","schema:url"],"id":"http://schema.org/url","required":true,"schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/url"},{"path":["schema:variableMeasured","schema:url","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/description"},{"path":["schema:variableMeasured","schema:url","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/name"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:indexedBy"],"id":"https://w3id.org/cdif/indexedBy","description":"CDIF addition (not in canonical DDI-CDI): the InstanceVariable(s) the contained Statistics index \u2014 the collection-level coordinate space. Marks the collection as per-variable-scoped: a StatisticsCollection carrying `cdif:indexedBy` MUST be attached via `schema:variableMeasured[i].cdif:isDescribedBy_StatisticsCollection` on one of the indexed variables, NOT at Dataset level via `cdif:statistics` (which is reserved for genuinely dataset-scope aggregates like row count).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/indexedBy"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics"],"id":"https://w3id.org/cdif/has_Statistics","description":"Statistics nodes carried by this collection (inline or @id-ref). cdif: namespaced and target-suffixed because the DDI-CDI cdi:has association is polymorphic.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/has_Statistics"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:typeOfStatistic"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfStatistic","description":"Controlled-vocabulary entry naming the kind of statistic \u2014 e.g. mean, median, count, sum, stdDev.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfStatistic"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:statistic"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/statistic","description":"Ordered list of Statistic value objects carried by this bundle. Order is significant \u2014 consumers MAY rely on array position.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/statistic"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:statistic","cdi:computationBase"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/computationBase","description":"The cases included in determining the statistic \u2014 Total (all cases, valid and missing), ValidOnly (valid values only), MissingOnly (invalid cases only).","schema_type":"string","enum":["MissingOnly","Total","ValidOnly"],"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/computationBase"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:statistic","cdi:content"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/content","description":"The value of the statistic expressed as a real number.","schema_type":"number","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/content"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:statistic","cdi:isWeighted"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isWeighted","description":"True if the statistic was computed using a weighting variable.","schema_type":"boolean","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/isWeighted"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:statistic","cdi:typeOfNumericValue"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfNumericValue","description":"The type of numeric value carried in cdi:content \u2014 decimal, float, or double.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfNumericValue"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdi:hasWeight"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight","description":"The InstanceVariable whose values were used as weights when computing the Statistic entries (inline cdifInstanceVariable node or an @id-reference).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:appliesTo"],"id":"https://w3id.org/cdif/appliesTo","description":"CDIF addition (not in canonical DDI-CDI): the InstanceVariable(s) this Statistics bundle summarizes \u2014 the per-bundle \"what these numbers describe\" link. Used **only** when this Statistics bundle sits inside a StatisticsCollection that indexes more than one variable, to disambiguate which variable each bundle describes. It MUST NOT appear on a Statistics bundle attached at Dataset level via `cdif:statistics`; per-variable stats belong under `schema:variableMeasured[i].cdif:isDescribedBy_StatisticsCollection` (the direct JSON mapping of the DDI-CDI `InstanceVariable.isDescribedBy` association).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/appliesTo"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics"],"id":"https://w3id.org/cdif/has_CategoryStatistics","description":"CategoryStatistics entries breaking this Statistics bundle down by Category. cdif: namespaced and target-suffixed because the DDI-CDI cdi:has association is polymorphic.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/has_CategoryStatistics"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:for"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/for","description":"The Category this CategoryStatistics is for (inline Category node or an @id-reference).","required":true,"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/for"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:for","cdif:displayLabel"],"id":"https://w3id.org/cdif/displayLabel","description":"Human-readable display label(s). CDIF-simplified from DDI-CDI Category.displayLabel (LabelForDisplay).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/displayLabel"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:for","cdif:definition"],"id":"https://w3id.org/cdif/definition","description":"Natural-language definition of the category. CDIF-simplified from DDI-CDI Category.definition (InternationalString).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/definition"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:for","cdif:descriptiveText"],"id":"https://w3id.org/cdif/descriptiveText","description":"Short natural-language account of the category. CDIF-simplified from DDI-CDI Category.descriptiveText (InternationalString).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/descriptiveText"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:for","cdif:name"],"id":"https://w3id.org/cdif/name","description":"Human-understandable name(s). CDIF-simplified from DDI-CDI Category.name (ObjectName) to plain strings.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"https://w3id.org/cdif/name"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:typeOfStatistic"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfStatistic","description":"Controlled-vocabulary entry naming the kind of statistic.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/typeOfStatistic"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:statistic"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/statistic","description":"Per-category Statistic value objects.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/statistic"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdif:has_Statistics","cdif:has_CategoryStatistics","cdi:hasWeight"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight","description":"The InstanceVariable whose values were used as weights (inline cdifInstanceVariable node or an @id-reference).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight"},{"path":["schema:variableMeasured","cdif:isDescribedBy_StatisticsCollection","cdi:hasWeight"],"id":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight","description":"The InstanceVariable whose values were used as weights (inline cdifInstanceVariable node or an @id-reference).","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifStatistics"],"effectiveId":"http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/hasWeight"}]}