{"defs":{},"properties":[{"path":["schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:additionalType","_anyOf","2"],"title":"a","keyword":"branch"},{"path":["schema:additionalType","_anyOf","2","skos:narrower"],"description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array"},{"path":["schema:additionalType","_anyOf","2","skos:broader"],"description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array"},{"path":["schema:additionalType","_anyOf","2","skos:inScheme"],"description":"Concept scheme(s) this concept belongs to."},{"path":["schema:additionalType","_anyOf","2","skos:note"],"description":"General note about this concept."},{"path":["schema:additionalType","_anyOf","2","skos:definition"],"description":"Formal explanation of the meaning of this concept."},{"path":["schema:additionalType","_anyOf","2","skos:notation"],"description":"Classification code for this concept within a scheme.","schema_type":"array"},{"path":["schema:additionalType","_anyOf","2","skos:prefLabel"],"description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true},{"path":["schema:additionalType","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","effectiveId":"http://schema.org/termCode"},{"path":["schema:additionalType","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"Name for the controlled vocabulary responsible for this keyword.","schema_type":"string","effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:additionalType","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","effectiveId":"http://schema.org/identifier"},{"path":["schema:additionalType","_anyOf","1","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability","schema_type":"string","effectiveId":"http://schema.org/propertyID"},{"path":["schema:additionalType","_anyOf","1","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"t