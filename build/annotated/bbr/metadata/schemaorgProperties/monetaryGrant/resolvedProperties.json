{"defs":{},"properties":[{"path":["schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for a particular grant","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:description"],"id":"http://schema.org/description","description":"description of the funding or grant","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/description"},{"path":["schema:name"],"id":"http://schema.org/name","description":"title of the grant","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/name"},{"path":["schema:funder"],"id":"http://schema.org/funder","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/funder"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2"],"title":"a","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"keyword":"branch"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:narrower"],"id":"http://www.w3.org/2004/02/skos/core#narrower","description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#narrower"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:broader"],"id":"http://www.w3.org/2004/02/skos/core#broader","description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:topConceptOf"],"id":"http://www.w3.org/2004/02/skos/core#topConceptOf","description":"Concept scheme(s) for which this is a top concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#topConceptOf"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","description":"Concept scheme(s) this concept belongs to.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:editorialNote"],"id":"http://www.w3.org/2004/02/skos/core#editorialNote","description":"Note for editors and maintainers.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#editorialNote"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:changeNote"],"id":"http://www.w3.org/2004/02/skos/core#changeNote","description":"Note documenting a change.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#changeNote"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:historyNote"],"id":"http://www.w3.org/2004/02/skos/core#historyNote","description":"Note about past state or use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#historyNote"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:note"],"id":"http://www.w3.org/2004/02/skos/core#note","description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:scopeNote"],"id":"http://www.w3.org/2004/02/skos/core#scopeNote","description":"Note clarifying meaning and/or intended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","2","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funder","_anyOf","1","schema:affiliation","schema:additionalType","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:funder","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:funder","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"restrict to email only. Schema.org allows telephone and postal contacts as well","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["schema:funder","schema:contactPoint","schema:email"],"id":"http://schema.org/email","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["schema:funder","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/affiliation"},{"path":["schema:funder","schema:affiliation","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:funder","schema:affiliation","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funder","schema:affiliation","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:funder","schema:affiliation","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:funder","schema:affiliation","schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:funder","schema:affiliation","schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:funder","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:funder","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funder","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["schema:funder","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"}]}