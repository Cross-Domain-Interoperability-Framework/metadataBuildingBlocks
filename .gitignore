build-local/
# Build tooling binaries — fetch on demand, do not commit:
#   curl -L -o tools/plantuml.jar https://github.com/plantuml/plantuml/releases/latest/download/plantuml.jar
tools/plantuml.jar
.idea/
bblocks-config-local.yml
bblocks-config-local.yaml
.volumes
*.bak
__pycache__/
# Local incremental-render cache for the model browser (regenerable):
cdif-uml-model/_plantuml/**/_render_cache.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
audit_full.txt
audit_check.txt
resolve_run.log
# Implementation-guide consistency reports (tools/audit_ig_consistency.py -o):
ig_audit.md
ig_audit.json
# ...and any archived annotated copy (ig_audit.applied-<date>.json)
ig_audit.*.json

# CDIF vocabulary inventory (tools/audit_cdif_vocabulary.py -o/--md):
# the annotated register is a working document, not a repo artifact --
# the ontology it feeds is the thing that gets committed.
cdif_ontology_register.json
cdif_ontology_register.md
cdif_inventory.json

# Rendered HTML views of CDIF records (tools/cdif_record_to_html.py)
htmlViews/

# A .pyc outside __pycache__/ (e.g. carried along in a file move)
# is not caught by the rule above.
*.pyc
