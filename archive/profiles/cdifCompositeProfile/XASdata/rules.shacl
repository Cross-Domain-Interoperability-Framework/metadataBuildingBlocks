@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/>.
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/>.
@base <https://www.ogc.org/rules/template/> .

# Rules are inherited from the schemas cited in the profile 'allOf'.
#
# Conformance model: two XAS tiers.
#   * MANDATORY tier -> xasCore/1.0 (required, below)
#   * OPTIONAL  tier -> xasOptional/1.0 (advisory; checked in xasOptional/rules.shacl)
#
# An XASdata record MUST declare conformance to the CDIF base profiles it composes
# plus the XAS mandatory tier. Overrides the generic cdifCore metadataProfileProperty
# (which requires core only) via same-URI shape merge; attached through the
# cdifCore catalog-record shape's sh:property reference.
cdifd:metadataProfileProperty
    a sh:PropertyShape ;
    sh:path  dcterms:conformsTo  ;
	sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <https://w3id.org/cdif/core/1.1> ;
    sh:hasValue <https://w3id.org/cdif/discovery/1.1> ;
    sh:hasValue <https://w3id.org/cdif/data_description/1.1> ;
    sh:hasValue <https://w3id.org/cdif/xasCore/1.0> ;
    sh:message "a CDIF XASdata metadata record must declare conformance to core/1.1, discovery/1.1, data_description/1.1 and the XAS mandatory tier xasCore/1.0 (all under https://w3id.org/cdif/)"
    .
