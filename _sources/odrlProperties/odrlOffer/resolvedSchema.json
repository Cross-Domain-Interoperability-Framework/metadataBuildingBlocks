{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODRL Offer",
  "description": "CDIF Access profile of an ODRL 2.2 Offer (https://www.w3.org/TR/odrl-model/#policy-offer): the baseline access and usage conditions a data provider sets for a digital object, without naming who they apply to (that is an ODRL Agreement). Built on the generic odrlPolicy block, which carries the ODRL structure; this block adds only CDIF's own rules. Draft from the CDIF Access spreadsheet (CDIF_Access_Profile_ODRL_Classes_Properties_Description.xlsx) and the cdifbook data_access chapter.\nKeys carry the odrl: prefix and the document's @context declares the odrl, cdifa1 (https://w3id.org/cdif/access/profile1/), rdf and xsd prefixes. The ODRL JSON-LD context is not used, so nothing coerces a string to an IRI: every IRI value (target, action, parties, operands) is an {\"@id\": ...} object.\nAn access condition (something done BEFORE the digital object is retrieved) is a permission duty constrained by odrl:event odrl:lt odrl:policyUsage (https://www.w3.org/TR/odrl-model/#duty-perm). Everything else is a usage condition: a permission (may do), an obligation (must do) or a prohibition (must not do).\nOPEN QUESTIONS are marked \"OPEN:\" below.",
  "type": "object",
  "allOf": [
    {
      "title": "ODRL Policy",
      "description": "An ODRL 2.2 Policy (https://www.w3.org/TR/odrl-model/#policy): a group of permissions, prohibitions and obligations, typed by one of its subclasses: Set (the default), Offer, Agreement, Request, Ticket, Assertion or Privacy. A target or party given at policy level applies to every rule (https://www.w3.org/TR/odrl-model/#composition), so each subclass requirement below is met by the policy-level property or by that property on every rule concerned. The subclass requirements are those stated in the ODRL vocabulary (https://www.w3.org/ns/odrl/2/ODRL22.ttl); requirements on meaning (e.g. an Offer grants no privileges to an assignee) cannot be checked by a schema.",
      "type": "object",
      "properties": {
        "@context": {
          "type": "object",
          "description": "JSON-LD namespace prefixes for ODRL properties.",
          "properties": {
            "odrl": {
              "const": "http://www.w3.org/ns/odrl/2/"
            }
          }
        },
        "@id": {
          "description": "Globally unique IRI for the policy (ODRL uid).",
          "type": "string",
          "format": "iri"
        },
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "enum": [
              "odrl:Policy",
              "odrl:Set",
              "odrl:Offer",
              "odrl:Agreement",
              "odrl:Request",
              "odrl:Ticket",
              "odrl:Assertion",
              "odrl:Privacy"
            ]
          }
        },
        "odrl:profile": {
          "description": "ODRL profiles the policy conforms to.",
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectReference"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectReference"
              }
            }
          ]
        },
        "odrl:inheritFrom": {
          "description": "Parent policies whose rules this policy inherits.",
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectReference"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectReference"
              }
            }
          ]
        },
        "odrl:conflict": {
          "description": "Strategy for resolving conflicts between permissions and prohibitions (odrl:conflict). Closed: ODRL defines exactly these three.",
          "type": "object",
          "properties": {
            "@id": {
              "enum": [
                "odrl:invalid",
                "http://www.w3.org/ns/odrl/2/invalid",
                "odrl:perm",
                "http://www.w3.org/ns/odrl/2/perm",
                "odrl:prohibit",
                "http://www.w3.org/ns/odrl/2/prohibit"
              ]
            }
          },
          "required": [
            "@id"
          ],
          "additionalProperties": false
        },
        "odrl:target": {
          "$ref": "#/$defs/Target"
        },
        "odrl:assigner": {
          "$ref": "#/$defs/PartyRef"
        },
        "odrl:assignee": {
          "$ref": "#/$defs/PartyRef"
        },
        "odrl:permission": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Rule"
              },
              {
                "properties": {
                  "@type": {
                    "contains": {
                      "const": "odrl:Permission"
                    }
                  },
                  "odrl:duty": {
                    "description": "Duties that must be fulfilled before the permission can be exercised.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Duty"
                    }
                  }
                }
              }
            ]
          }
        },
        "odrl:prohibition": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Rule"
              },
              {
                "properties": {
                  "@type": {
                    "contains": {
                      "const": "odrl:Prohibition"
                    }
                  },
                  "odrl:remedy": {
                    "description": "Duties owed if the prohibition is infringed.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Duty"
                    }
                  }
                }
              }
            ]
          }
        },
        "odrl:obligation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Duty"
          }
        }
      },
      "required": [
        "@type",
        "@id"
      ],
      "anyOf": [
        {
          "required": [
            "odrl:permission"
          ]
        },
        {
          "required": [
            "odrl:prohibition"
          ]
        },
        {
          "required": [
            "odrl:obligation"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Set"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasTarget"
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Offer"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasPermissionOrProhibition"
              },
              {
                "$ref": "#/$defs/hasAssigner"
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Agreement"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasPermissionOrProhibition"
              },
              {
                "$ref": "#/$defs/hasAssigner"
              },
              {
                "$ref": "#/$defs/hasAssignee"
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Request"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasPermissionOrProhibition"
              },
              {
                "$ref": "#/$defs/hasTarget"
              },
              {
                "$ref": "#/$defs/hasAssignee"
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Ticket"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasPermissionOrProhibition"
              },
              {
                "$ref": "#/$defs/hasTarget"
              },
              {
                "description": "A Ticket names no assignee; it is granted to whoever holds it.",
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "odrl:assignee"
                      ]
                    },
                    {
                      "properties": {
                        "odrl:permission": {
                          "contains": {
                            "required": [
                              "odrl:assignee"
                            ]
                          }
                        }
                      },
                      "required": [
                        "odrl:permission"
                      ]
                    },
                    {
                      "properties": {
                        "odrl:prohibition": {
                          "contains": {
                            "required": [
                              "odrl:assignee"
                            ]
                          }
                        }
                      },
                      "required": [
                        "odrl:prohibition"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Assertion"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasPermissionOrProhibition"
              },
              {
                "$ref": "#/$defs/hasTarget"
              },
              {
                "anyOf": [
                  {
                    "$ref": "#/$defs/hasAssigner"
                  },
                  {
                    "$ref": "#/$defs/hasAssignee"
                  }
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "@type": {
                "contains": {
                  "const": "odrl:Privacy"
                }
              }
            },
            "required": [
              "@type"
            ]
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/hasPermissionOrProhibition"
              },
              {
                "$ref": "#/$defs/hasTarget"
              },
              {
                "$ref": "#/$defs/hasAssigner"
              },
              {
                "$ref": "#/$defs/hasAssignee"
              },
              {
                "description": "The rules must include a duty describing obligations on the use of personal information.",
                "anyOf": [
                  {
                    "required": [
                      "odrl:obligation"
                    ]
                  },
                  {
                    "properties": {
                      "odrl:permission": {
                        "contains": {
                          "required": [
                            "odrl:duty"
                          ]
                        }
                      }
                    },
                    "required": [
                      "odrl:permission"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "properties": {
    "@context": {
      "type": "object",
      "description": "JSON-LD namespace prefixes for ODRL policy properties. Not required: an Offer embedded in a CDIF record inherits the record's @context.",
      "properties": {
        "odrl": {
          "const": "http://www.w3.org/ns/odrl/2/"
        },
        "cdifa1": {
          "const": "https://w3id.org/cdif/access/profile1/"
        },
        "rdf": {
          "const": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
        },
        "xsd": {
          "const": "http://www.w3.org/2001/XMLSchema#"
        }
      }
    },
    "@type": {
      "description": "Always includes odrl:Offer.",
      "contains": {
        "const": "odrl:Offer"
      }
    },
    "@id": {
      "description": "Globally unique, resolvable IRI for this Offer (the spreadsheet's uid). A resolver should be able to return application/ld+json, not only an HTML page."
    },
    "odrl:profile": {
      "description": "The CDIF Access ODRL profile this policy uses, which supplies the cdifa1: actions the ODRL core vocabulary lacks (download, assent, datadestruction, ...). OPEN: nothing is published at this IRI yet, and it names a .ttl file where ODRL expects a profile identifier. The cdifa1: form is accepted because compaction under the cdifa1 prefix rewrites the full IRI to it.",
      "type": "object",
      "properties": {
        "@id": {
          "enum": [
            "https://w3id.org/cdif/access/profile1/cdifa1.ttl",
            "cdifa1:cdifa1.ttl"
          ]
        }
      },
      "required": [
        "@id"
      ]
    },
    "odrl:assigner": {
      "description": "The party issuing the Offer, normally the repository or data custodian, given once at policy level. ODRL also accepts an assigner on every rule instead; CDIF asks for the policy-level form. The spreadsheet does not list an assigner yet."
    },
    "odrl:permission": {
      "description": "Actions a user may perform on the target (usage conditions).",
      "minItems": 1,
      "items": {
        "properties": {
          "odrl:action": {
            "description": "OPEN: the cdifa1 action vocabulary is not defined, so values are not enumerated; whether it is an ODRL profile or a standalone controlled vocabulary is still to be settled."
          },
          "odrl:assignee": {
            "description": "Who may exercise the permission, as a party or a (refined) PartyCollection, e.g. registered users located in the UK. This is the book's form; the spreadsheet scopes users with odrl:constraint instead. OPEN: settle on one, or say when each is used."
          },
          "odrl:constraint": {
            "description": "Conditions on exercising the permission, e.g. only users located in the UK (the spreadsheet's way of scoping users; see odrl:assignee)."
          },
          "odrl:duty": {
            "description": "Access conditions: actions that must be completed before the permitted action, e.g. assent to an End User Licence before download.",
            "items": {
              "description": "A permission duty carrying the accessConditionMarker. The spreadsheet gives the duty action as 1..*; ODRL allows one action per rule, so several pre-conditions are several duties. OPEN: the spreadsheet does not say what an assent duty assents to (e.g. which licence document); a duty target is one candidate. OPEN: the spreadsheet lists constraint @type with cardinality 1 but gives no value and omits it on this constraint, so it is optional.",
              "type": "object",
              "properties": {
                "odrl:constraint": {
                  "contains": {
                    "description": "The constraint odrl:event odrl:lt odrl:policyUsage: the duty must be fulfilled before the permission is exercised. In CDIF Access this is what marks a duty as an access condition. Each operand accepts the odrl: compact IRI and the full IRI.",
                    "type": "object",
                    "properties": {
                      "odrl:leftOperand": {
                        "type": "object",
                        "properties": {
                          "@id": {
                            "enum": [
                              "odrl:event",
                              "http://www.w3.org/ns/odrl/2/event"
                            ]
                          }
                        },
                        "required": [
                          "@id"
                        ]
                      },
                      "odrl:operator": {
                        "type": "object",
                        "properties": {
                          "@id": {
                            "enum": [
                              "odrl:lt",
                              "http://www.w3.org/ns/odrl/2/lt"
                            ]
                          }
                        },
                        "required": [
                          "@id"
                        ]
                      },
                      "odrl:rightOperand": {
                        "type": "object",
                        "properties": {
                          "@id": {
                            "enum": [
                              "odrl:policyUsage",
                              "http://www.w3.org/ns/odrl/2/policyUsage"
                            ]
                          }
                        },
                        "required": [
                          "@id"
                        ]
                      }
                    },
                    "required": [
                      "odrl:leftOperand",
                      "odrl:operator",
                      "odrl:rightOperand"
                    ]
                  }
                }
              },
              "required": [
                "odrl:action",
                "odrl:constraint"
              ]
            }
          }
        },
        "required": [
          "odrl:target",
          "odrl:action"
        ]
      }
    },
    "odrl:obligation": {
      "description": "Actions every user of the target must perform, e.g. destroy the data at the end of a project. The spreadsheet gives 1..*; drafted as 0..* because an Offer with only permissions is common. OPEN: confirm."
    },
    "odrl:prohibition": {
      "description": "Actions a user must not perform, e.g. share TRE credentials.",
      "items": {
        "required": [
          "odrl:target",
          "odrl:action"
        ]
      }
    }
  },
  "required": [
    "@type",
    "@id",
    "odrl:profile",
    "odrl:assigner",
    "odrl:permission"
  ],
  "$defs": {
    "ObjectReference": {
      "title": "Object Reference",
      "description": "A reference to a node defined elsewhere, by its @id.",
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "description": "resolvable @id of the referenced node"
        }
      },
      "required": [
        "@id"
      ],
      "additionalProperties": false
    },
    "OdrlConstraint": {
      "title": "ODRL Constraint",
      "description": "An ODRL 2.2 Constraint (https://www.w3.org/TR/odrl-model/#constraint) or LogicalConstraint (https://www.w3.org/TR/odrl-model/#constraint-logical). A Constraint compares a left operand with a right operand using an operator, e.g. odrl:spatial odrl:eq <country>. A LogicalConstraint combines constraints with exactly one of odrl:and, odrl:or, odrl:xone or odrl:andSequence. Operands and operators are open IRIs (odrlTerms), so ODRL profile terms validate.",
      "type": "object",
      "properties": {
        "@context": {
          "type": "object",
          "description": "JSON-LD namespace prefixes for ODRL properties.",
          "properties": {
            "odrl": {
              "const": "http://www.w3.org/ns/odrl/2/"
            }
          }
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "@id": {
              "description": "Optional; needed when a LogicalConstraint refers to this constraint by reference.",
              "type": "string",
              "format": "iri"
            },
            "@type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "odrl:Constraint"
              }
            },
            "odrl:leftOperand": {
              "description": "Reference to an ODRL LeftOperand left operand. Open: any IRI is accepted, so ODRL profile terms (e.g. cdifa1:) validate; the examples list the 32 non-deprecated ODRL 2.2 LeftOperand terms.",
              "type": "object",
              "properties": {
                "@id": {
                  "type": "string",
                  "examples": [
                    "odrl:absolutePosition",
                    "odrl:absoluteSize",
                    "odrl:absoluteSpatialPosition",
                    "odrl:absoluteTemporalPosition",
                    "odrl:count",
                    "odrl:dateTime",
                    "odrl:delayPeriod",
                    "odrl:deliveryChannel",
                    "odrl:elapsedTime",
                    "odrl:event",
                    "odrl:fileFormat",
                    "odrl:industry",
                    "odrl:language",
                    "odrl:media",
                    "odrl:meteredTime",
                    "odrl:payAmount",
                    "odrl:percentage",
                    "odrl:product",
                    "odrl:purpose",
                    "odrl:recipient",
                    "odrl:relativePosition",
                    "odrl:relativeSize",
                    "odrl:relativeSpatialPosition",
                    "odrl:relativeTemporalPosition",
                    "odrl:resolution",
                    "odrl:spatial",
                    "odrl:spatialCoordinates",
                    "odrl:systemDevice",
                    "odrl:timeInterval",
                    "odrl:unitOfCount",
                    "odrl:version",
                    "odrl:virtualLocation"
                  ]
                }
              },
              "required": [
                "@id"
              ],
              "additionalProperties": false
            },
            "odrl:operator": {
              "description": "Reference to an ODRL Operator operator. Open: any IRI is accepted, so ODRL profile terms (e.g. cdifa1:) validate; the examples list the 12 non-deprecated ODRL 2.2 Operator terms.",
              "type": "object",
              "properties": {
                "@id": {
                  "type": "string",
                  "examples": [
                    "odrl:eq",
                    "odrl:gt",
                    "odrl:gteq",
                    "odrl:hasPart",
                    "odrl:isA",
                    "odrl:isAllOf",
                    "odrl:isAnyOf",
                    "odrl:isNoneOf",
                    "odrl:isPartOf",
                    "odrl:lt",
                    "odrl:lteq",
                    "odrl:neq"
                  ]
                }
              },
              "required": [
                "@id"
              ],
              "additionalProperties": false
            },
            "odrl:rightOperand": {
              "description": "A literal, a value object ({\"@value\", \"@type\"}) or an {@id} reference."
            },
            "odrl:rightOperandReference": {
              "$ref": "#/$defs/ObjectReference",
              "description": "An IRI whose dereferenced value is the right operand."
            },
            "odrl:dataType": {
              "$ref": "#/$defs/ObjectReference",
              "description": "Datatype of the right operand, e.g. xsd:decimal."
            },
            "odrl:unit": {
              "$ref": "#/$defs/ObjectReference",
              "description": "Unit of the right operand, e.g. a currency or unit of measure."
            },
            "odrl:status": {
              "description": "The current value of the left operand, for comparison with the right operand."
            }
          },
          "required": [
            "odrl:leftOperand",
            "odrl:operator"
          ],
          "anyOf": [
            {
              "required": [
                "odrl:rightOperand"
              ]
            },
            {
              "required": [
                "odrl:rightOperandReference"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "@id": {
              "type": "string",
              "format": "iri"
            },
            "@type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "odrl:LogicalConstraint"
              }
            },
            "odrl:and": {
              "$ref": "#/$defs/constraintList",
              "description": "All of the constraints must be satisfied."
            },
            "odrl:or": {
              "$ref": "#/$defs/constraintList",
              "description": "At least one of the constraints must be satisfied."
            },
            "odrl:xone": {
              "$ref": "#/$defs/constraintList",
              "description": "Exactly one of the constraints must be satisfied."
            },
            "odrl:andSequence": {
              "$ref": "#/$defs/constraintList",
              "description": "All of the constraints must be satisfied, in order."
            }
          },
          "oneOf": [
            {
              "required": [
                "odrl:and"
              ]
            },
            {
              "required": [
                "odrl:or"
              ]
            },
            {
              "required": [
                "odrl:xone"
              ]
            },
            {
              "required": [
                "odrl:andSequence"
              ]
            }
          ]
        }
      ]
    },
    "Target": {
      "description": "The asset, as a reference or an Asset or AssetCollection node.",
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectReference"
        },
        {
          "title": "ODRL Asset",
          "description": "An ODRL 2.2 Asset (https://www.w3.org/TR/odrl-model/#asset) or AssetCollection (https://www.w3.org/TR/odrl-model/#asset-collection): the resource a rule applies to. In CDIF this is normally a distribution or data service, identified by its IRI. An AssetCollection groups assets: either the collection itself, identified by @id, or a subset of one, where odrl:source names the collection and odrl:refinement narrows it (e.g. the CSV distributions of a dataset).",
          "type": "object",
          "properties": {
            "@context": {
              "type": "object",
              "description": "JSON-LD namespace prefixes for ODRL properties.",
              "properties": {
                "odrl": {
                  "const": "http://www.w3.org/ns/odrl/2/"
                }
              }
            }
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "odrl:Asset"
                  }
                },
                "@id": {
                  "type": "string",
                  "format": "iri"
                },
                "odrl:partOf": {
                  "description": "AssetCollections this asset is a member of.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ObjectReference"
                  }
                }
              },
              "required": [
                "@type",
                "@id"
              ]
            },
            {
              "description": "Per ODRL, a refined collection is identified through odrl:source, so odrl:refinement requires odrl:source.",
              "type": "object",
              "properties": {
                "@type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "odrl:AssetCollection"
                  }
                },
                "@id": {
                  "type": "string",
                  "format": "iri"
                },
                "odrl:source": {
                  "$ref": "#/$defs/ObjectReference",
                  "description": "The collection this one is drawn from."
                },
                "odrl:refinement": {
                  "description": "Constraints selecting the members of odrl:source that belong to this collection.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/OdrlConstraint"
                  }
                }
              },
              "required": [
                "@type"
              ],
              "anyOf": [
                {
                  "required": [
                    "@id"
                  ]
                },
                {
                  "required": [
                    "odrl:source"
                  ]
                }
              ],
              "dependentRequired": {
                "odrl:refinement": [
                  "odrl:source"
                ]
              }
            }
          ]
        }
      ]
    },
    "PartyRef": {
      "description": "A party, as a reference or a Party or PartyCollection node.",
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectReference"
        },
        {
          "title": "ODRL Party",
          "description": "An ODRL 2.2 Party (https://www.w3.org/TR/odrl-model/#party) or PartyCollection (https://www.w3.org/TR/odrl-model/#party-collection): who takes a role (assigner, assignee) in a rule. A Party is a person, organization or agent identified by its IRI. A PartyCollection is a group of parties: either the collection itself, identified by @id, or a subset of one, where odrl:source names the collection and odrl:refinement narrows it (e.g. registered users located in the UK).",
          "type": "object",
          "properties": {
            "@context": {
              "type": "object",
              "description": "JSON-LD namespace prefixes for ODRL properties.",
              "properties": {
                "odrl": {
                  "const": "http://www.w3.org/ns/odrl/2/"
                }
              }
            }
          },
          "anyOf": [
            {
              "description": "Further description (e.g. schema:name) is allowed.",
              "type": "object",
              "properties": {
                "@type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "odrl:Party"
                  }
                },
                "@id": {
                  "type": "string",
                  "format": "iri"
                }
              },
              "required": [
                "@type",
                "@id"
              ]
            },
            {
              "description": "Per ODRL, a refined collection is identified through odrl:source, so odrl:refinement requires odrl:source.",
              "type": "object",
              "properties": {
                "@type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "odrl:PartyCollection"
                  }
                },
                "@id": {
                  "type": "string",
                  "format": "iri"
                },
                "odrl:source": {
                  "$ref": "#/$defs/ObjectReference",
                  "description": "The collection this one is drawn from."
                },
                "odrl:refinement": {
                  "description": "Constraints selecting the members of odrl:source that belong to this collection.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/OdrlConstraint"
                  }
                }
              },
              "required": [
                "@type"
              ],
              "anyOf": [
                {
                  "required": [
                    "@id"
                  ]
                },
                {
                  "required": [
                    "odrl:source"
                  ]
                }
              ],
              "dependentRequired": {
                "odrl:refinement": [
                  "odrl:source"
                ]
              }
            }
          ]
        }
      ]
    },
    "Duty": {
      "allOf": [
        {
          "$ref": "#/$defs/Rule"
        },
        {
          "properties": {
            "@type": {
              "contains": {
                "const": "odrl:Duty"
              }
            },
            "odrl:consequence": {
              "description": "Further duties owed if this duty is not fulfilled.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Duty"
              }
            }
          }
        }
      ]
    },
    "hasTarget": {
      "description": "A target at policy level, or on every rule.",
      "anyOf": [
        {
          "required": [
            "odrl:target"
          ]
        },
        {
          "properties": {
            "odrl:permission": {
              "items": {
                "required": [
                  "odrl:target"
                ]
              }
            },
            "odrl:prohibition": {
              "items": {
                "required": [
                  "odrl:target"
                ]
              }
            },
            "odrl:obligation": {
              "items": {
                "required": [
                  "odrl:target"
                ]
              }
            }
          }
        }
      ]
    },
    "hasPermissionOrProhibition": {
      "anyOf": [
        {
          "required": [
            "odrl:permission"
          ]
        },
        {
          "required": [
            "odrl:prohibition"
          ]
        }
      ]
    },
    "hasAssigner": {
      "description": "An assigner at policy level, or on every permission and prohibition.",
      "anyOf": [
        {
          "required": [
            "odrl:assigner"
          ]
        },
        {
          "properties": {
            "odrl:permission": {
              "items": {
                "required": [
                  "odrl:assigner"
                ]
              }
            },
            "odrl:prohibition": {
              "items": {
                "required": [
                  "odrl:assigner"
                ]
              }
            }
          }
        }
      ]
    },
    "hasAssignee": {
      "description": "An assignee at policy level, or on every permission and prohibition.",
      "anyOf": [
        {
          "required": [
            "odrl:assignee"
          ]
        },
        {
          "properties": {
            "odrl:permission": {
              "items": {
                "required": [
                  "odrl:assignee"
                ]
              }
            },
            "odrl:prohibition": {
              "items": {
                "required": [
                  "odrl:assignee"
                ]
              }
            }
          }
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "format": "iri"
        },
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "odrl:target": {
          "$ref": "#/$defs/Target"
        },
        "odrl:output": {
          "$ref": "#/$defs/Target",
          "description": "An asset created by exercising the action, e.g. the result of odrl:derive."
        },
        "odrl:action": {
          "title": "ODRL Action",
          "description": "An ODRL 2.2 Action (https://www.w3.org/TR/odrl-model/#action) as used in a rule: either a reference to the action ({\"@id\": \"odrl:use\"}), or, when the action itself is narrowed, an object holding the action in rdf:value plus odrl:refinement constraints (e.g. print, at most 1200 dpi). Actions are open IRIs (odrlTerms), so ODRL profile actions validate.",
          "type": "object",
          "properties": {
            "@context": {
              "type": "object",
              "description": "JSON-LD namespace prefixes for ODRL properties.",
              "properties": {
                "odrl": {
                  "const": "http://www.w3.org/ns/odrl/2/"
                },
                "rdf": {
                  "const": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
                }
              }
            }
          },
          "anyOf": [
            {
              "description": "Reference to an ODRL Action action. Open: any IRI is accepted, so ODRL profile terms (e.g. cdifa1:) validate; the examples list the 42 non-deprecated ODRL 2.2 Action terms.",
              "type": "object",
              "properties": {
                "@id": {
                  "type": "string",
                  "examples": [
                    "odrl:acceptTracking",
                    "odrl:aggregate",
                    "odrl:annotate",
                    "odrl:anonymize",
                    "odrl:archive",
                    "odrl:attribute",
                    "odrl:compensate",
                    "odrl:concurrentUse",
                    "odrl:delete",
                    "odrl:derive",
                    "odrl:digitize",
                    "odrl:display",
                    "odrl:distribute",
                    "odrl:ensureExclusivity",
                    "odrl:execute",
                    "odrl:extract",
                    "odrl:give",
                    "odrl:grantUse",
                    "odrl:include",
                    "odrl:index",
                    "odrl:inform",
                    "odrl:install",
                    "odrl:modify",
                    "odrl:move",
                    "odrl:nextPolicy",
                    "odrl:obtainConsent",
                    "odrl:play",
                    "odrl:present",
                    "odrl:print",
                    "odrl:read",
                    "odrl:reproduce",
                    "odrl:reviewPolicy",
                    "odrl:sell",
                    "odrl:stream",
                    "odrl:synchronize",
                    "odrl:textToSpeech",
                    "odrl:transfer",
                    "odrl:transform",
                    "odrl:translate",
                    "odrl:uninstall",
                    "odrl:use",
                    "odrl:watermark"
                  ]
                }
              },
              "required": [
                "@id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "rdf:value": {
                  "description": "Reference to an ODRL Action action. Open: any IRI is accepted, so ODRL profile terms (e.g. cdifa1:) validate; the examples list the 42 non-deprecated ODRL 2.2 Action terms.",
                  "type": "object",
                  "properties": {
                    "@id": {
                      "type": "string",
                      "examples": [
                        "odrl:acceptTracking",
                        "odrl:aggregate",
                        "odrl:annotate",
                        "odrl:anonymize",
                        "odrl:archive",
                        "odrl:attribute",
                        "odrl:compensate",
                        "odrl:concurrentUse",
                        "odrl:delete",
                        "odrl:derive",
                        "odrl:digitize",
                        "odrl:display",
                        "odrl:distribute",
                        "odrl:ensureExclusivity",
                        "odrl:execute",
                        "odrl:extract",
                        "odrl:give",
                        "odrl:grantUse",
                        "odrl:include",
                        "odrl:index",
                        "odrl:inform",
                        "odrl:install",
                        "odrl:modify",
                        "odrl:move",
                        "odrl:nextPolicy",
                        "odrl:obtainConsent",
                        "odrl:play",
                        "odrl:present",
                        "odrl:print",
                        "odrl:read",
                        "odrl:reproduce",
                        "odrl:reviewPolicy",
                        "odrl:sell",
                        "odrl:stream",
                        "odrl:synchronize",
                        "odrl:textToSpeech",
                        "odrl:transfer",
                        "odrl:transform",
                        "odrl:translate",
                        "odrl:uninstall",
                        "odrl:use",
                        "odrl:watermark"
                      ]
                    }
                  },
                  "required": [
                    "@id"
                  ],
                  "additionalProperties": false
                },
                "odrl:refinement": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/OdrlConstraint"
                  }
                }
              },
              "required": [
                "rdf:value",
                "odrl:refinement"
              ]
            }
          ]
        },
        "odrl:assigner": {
          "$ref": "#/$defs/PartyRef"
        },
        "odrl:assignee": {
          "$ref": "#/$defs/PartyRef"
        },
        "odrl:constraint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OdrlConstraint"
          }
        }
      },
      "required": [
        "odrl:action"
      ]
    },
    "constraintList": {
      "description": "The operand constraints, as an RDF list ({\"@list\": [...]}), each inline or an {@id} reference.",
      "type": "object",
      "properties": {
        "@list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ObjectReference"
              },
              {
                "type": "object",
                "properties": {
                  "@id": {
                    "description": "Optional; needed when a LogicalConstraint refers to this constraint by reference.",
                    "type": "string",
                    "format": "iri"
                  },
                  "@type": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "contains": {
                      "const": "odrl:Constraint"
                    }
                  },
                  "odrl:leftOperand": {
                    "description": "Reference to an ODRL LeftOperand left operand. Open: any IRI is accepted, so ODRL profile terms (e.g. cdifa1:) validate; the examples list the 32 non-deprecated ODRL 2.2 LeftOperand terms.",
                    "type": "object",
                    "properties": {
                      "@id": {
                        "type": "string",
                        "examples": [
                          "odrl:absolutePosition",
                          "odrl:absoluteSize",
                          "odrl:absoluteSpatialPosition",
                          "odrl:absoluteTemporalPosition",
                          "odrl:count",
                          "odrl:dateTime",
                          "odrl:delayPeriod",
                          "odrl:deliveryChannel",
                          "odrl:elapsedTime",
                          "odrl:event",
                          "odrl:fileFormat",
                          "odrl:industry",
                          "odrl:language",
                          "odrl:media",
                          "odrl:meteredTime",
                          "odrl:payAmount",
                          "odrl:percentage",
                          "odrl:product",
                          "odrl:purpose",
                          "odrl:recipient",
                          "odrl:relativePosition",
                          "odrl:relativeSize",
                          "odrl:relativeSpatialPosition",
                          "odrl:relativeTemporalPosition",
                          "odrl:resolution",
                          "odrl:spatial",
                          "odrl:spatialCoordinates",
                          "odrl:systemDevice",
                          "odrl:timeInterval",
                          "odrl:unitOfCount",
                          "odrl:version",
                          "odrl:virtualLocation"
                        ]
                      }
                    },
                    "required": [
                      "@id"
                    ],
                    "additionalProperties": false
                  },
                  "odrl:operator": {
                    "description": "Reference to an ODRL Operator operator. Open: any IRI is accepted, so ODRL profile terms (e.g. cdifa1:) validate; the examples list the 12 non-deprecated ODRL 2.2 Operator terms.",
                    "type": "object",
                    "properties": {
                      "@id": {
                        "type": "string",
                        "examples": [
                          "odrl:eq",
                          "odrl:gt",
                          "odrl:gteq",
                          "odrl:hasPart",
                          "odrl:isA",
                          "odrl:isAllOf",
                          "odrl:isAnyOf",
                          "odrl:isNoneOf",
                          "odrl:isPartOf",
                          "odrl:lt",
                          "odrl:lteq",
                          "odrl:neq"
                        ]
                      }
                    },
                    "required": [
                      "@id"
                    ],
                    "additionalProperties": false
                  },
                  "odrl:rightOperand": {
                    "description": "A literal, a value object ({\"@value\", \"@type\"}) or an {@id} reference."
                  },
                  "odrl:rightOperandReference": {
                    "$ref": "#/$defs/ObjectReference",
                    "description": "An IRI whose dereferenced value is the right operand."
                  },
                  "odrl:dataType": {
                    "$ref": "#/$defs/ObjectReference",
                    "description": "Datatype of the right operand, e.g. xsd:decimal."
                  },
                  "odrl:unit": {
                    "$ref": "#/$defs/ObjectReference",
                    "description": "Unit of the right operand, e.g. a currency or unit of measure."
                  },
                  "odrl:status": {
                    "description": "The current value of the left operand, for comparison with the right operand."
                  }
                },
                "required": [
                  "odrl:leftOperand",
                  "odrl:operator"
                ],
                "anyOf": [
                  {
                    "required": [
                      "odrl:rightOperand"
                    ]
                  },
                  {
                    "required": [
                      "odrl:rightOperandReference"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "required": [
        "@list"
      ]
    }
  }
}
