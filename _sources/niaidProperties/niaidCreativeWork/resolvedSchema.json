{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIAID creative work",
  "description": "A work that a NIAID Data Discovery Portal dataset cites or is cited by, with the portal's PubMed id, DOI and journal names. The portal types these as ScholarlyArticle or CreativeWork; JSON Schema cannot follow schema.org's subclass hierarchy, so both are listed.",
  "type": "object",
  "properties": {
    "@type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "enum": [
          "schema:CreativeWork",
          "schema:ScholarlyArticle"
        ]
      },
      "minItems": 1
    },
    "schema:name": {
      "type": "string"
    },
    "schema:url": {
      "type": "string"
    },
    "nde:pmid": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "The PubMed id, digits only."
    },
    "nde:doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "The DOI, as the portal gives it."
    },
    "nde:journalName": {
      "type": "string"
    },
    "nde:journalNameAbbrev": {
      "type": "string"
    }
  },
  "required": [
    "@type"
  ]
}
