@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@prefix nde: <https://discovery.biothings.io/ns/nde/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# nde:isCurated is checked by niaidDefinedTerm/rules.shacl.

cdifd:NiaidNctidShape a sh:NodeShape ;
    sh:targetSubjectsOf nde:nctid ;
    sh:property [ sh:path nde:nctid ; sh:pattern "^NCT[0-9]{8}$" ;
            sh:severity sh:Violation ;
            sh:message "nde:nctid must be a ClinicalTrials.gov id: NCT and eight digits." ] .
