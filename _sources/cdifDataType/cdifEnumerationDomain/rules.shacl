@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix cdi:    <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdif:   <https://w3id.org/cdif/> .
@prefix cdifd:  <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# ------------------------------------------------------------
# cdif:EnumerationDomain — extension point documenting a
# codification vocabulary as an enumerated value domain.
# ------------------------------------------------------------

cdifd:cdifEnumerationDomainShape
	a sh:NodeShape ;
	sh:targetClass cdif:EnumerationDomain ;

	# -- RECOMMENDED (Warning) --

	sh:property [
		sh:path schema:name ;
		sh:minCount 1 ;
		sh:datatype xsd:string ;
		sh:severity sh:Warning ;
		sh:message "A cdif:EnumerationDomain should carry a schema:name (human-readable label)" ;
	] ;

	# Was sh:Violation with sh:minCount 1, which contradicted the JSON Schema:
	# cdif:references stopped being required on 2026-09-25 and this half was left
	# behind, so a record omitting it passed JSON Schema and failed SHACL (#42).
	# The binding is preferred but not mandatory -- naming the codelist is better
	# than describing it in prose -- so the recommendation is a Warning here, and
	# the actual requirement is the conditional shape below.
	sh:property [
		sh:path cdif:references ;
		sh:minCount 1 ;
		sh:severity sh:Warning ;
		sh:message "A cdif:EnumerationDomain should carry cdif:references (a skos:ConceptScheme or @id-reference to the codification); if it does not, schema:description must say what values the domain admits" ;
	] ;

	# -- INFORMATIONAL (Info) --

	sh:property [
		sh:path cdif:identifier ;
		sh:severity sh:Info ;
		sh:message "A cdif:EnumerationDomain may include a cdif:identifier (schema:identifier / PropertyValue)" ;
	] ;

	sh:property [
		sh:path cdif:purpose ;
		sh:severity sh:Info ;
		sh:message "A cdif:EnumerationDomain may include a cdif:purpose describing intent or use" ;
	] ;
	.

# The JSON Schema twin of this is `if: not: required: [cdif:references], then:
# required: [schema:description]` in schema.yaml. An EnumerationDomain must say
# what its values are one way or the other: by naming the codelist that defines
# them, or in prose. Carrying neither is the Violation.
#
# sh:or over two property shapes, not sh:minCount on either -- a minCount on
# both would require both, and a minCount on neither would require nothing.
cdifd:cdifEnumerationDomainValuesStatedShape
	a sh:NodeShape ;
	sh:targetClass cdif:EnumerationDomain ;
	sh:or (
		[ sh:property [ sh:path cdif:references ; sh:minCount 1 ; ] ]
		[ sh:property [ sh:path schema:description ; sh:minCount 1 ; ] ]
	) ;
	sh:severity sh:Violation ;
	sh:message "A cdif:EnumerationDomain must either carry cdif:references (the codelist whose concepts define its values) or schema:description (prose stating what values it admits). It carries neither, so nothing says what this domain enumerates." ;
	.
