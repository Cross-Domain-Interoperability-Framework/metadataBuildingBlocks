{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DDI-CDI Data Structure Component",
    "description": "Role given to a represented variable in the context of a long or wide data structure to identify the units associated to data points, and in dimensional and key value data structures to provide identifying fields for the instance values.",
    "anyOf": [
        {
            "$ref": "#/$defs/IdentifierComponent"
        },
        {
            "$ref": "#/$defs/MeasureComponent"
        },
        {
            "$ref": "#/$defs/AttributeComponent"
        },
        {
            "$ref": "#/$defs/DimensionComponent"
        },
        {
            "$ref": "#/$defs/VariableValueComponent"
        },
        {
            "$ref": "#/$defs/VariableDescriptorComponent"
        }
    ],
    "$defs": {
        "cdifConceptOrTermOrString": {
            "$ref": "../cdifConceptOrTermOrString/cdifConceptOrTermOrStringSchema.json"
        }
    }
}
