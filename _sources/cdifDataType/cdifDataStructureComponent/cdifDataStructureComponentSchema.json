{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DDI-CDI Data Structure Component",
    "description": "Role given to a represented variable in the context of a long or wide data structure to identify the units associated to data points, and in dimensional and key value data structures to provide identifying fields for the instance values.",
    "anyOf": [
        {
            "$ref": "#/$defs/IdentifierComponent"
        },
        {
            "$ref": "#/$defs/MeasureComponent"
        },
        {
            "$ref": "#/$defs/AttributeComponent"
        },
        {
            "$ref": "#/$defs/DimensionComponent"
        },
        {
            "$ref": "#/$defs/VariableValueComponent"
        },
        {
            "$ref": "#/$defs/VariableDescriptorComponent"
        }
    ],
    "$defs": {
        "cdifConceptOrTermOrString": {
            "$ref": "../cdifConceptOrTermOrString/cdifConceptOrTermOrStringSchema.json"
        },
        "cdifConceptOrTerm": {
            "$ref": "../cdifConceptOrTerm/cdifConceptOrTermSchema.json"
        },
        "DataStructureComponent": {
            "type": "object",
            "description": "Members common to every data structure component. Composed into each component below with allOf; not a component type in its own right, and not a branch of this schema's root anyOf.",
            "properties": {
                "@id": {
                    "type": "string",
                    "description": "Identifier for this DataStructureComponent node"
                },
                "cdif:identifier": {
                    "$ref": "../../schemaorgProperties/identifier/identifierSchema.json",
                    "description": "Identifier for objects requiring short- or long-lasting referencing and management."
                },
                "cdif:isDefinedBy_Variable": {
                    "description": "The variable this component is a role of -- a RepresentedVariable or an InstanceVariable, inline or by @id reference. See the note above $defs.",
                    "anyOf": [
                        {
                            "$ref": "../../cdifDataType/cdifRepresentedVariable/cdifRepresentedVariableSchema.json"
                        },
                        {
                            "$ref": "../../cdifDataType/cdifInstanceVariable/cdifInstanceVariableSchema.json"
                        },
                        {
                            "$ref": "../objectReference/objectReferenceSchema.json"
                        }
                    ]
                },
                "cdif:semantic": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/cdifConceptOrTermOrString"
                    },
                    "minItems": 1,
                    "description": "Qualifies the purpose or use expressed as a paired external controlled vocabulary."
                }
            }
        },
        "IdentifierComponent": {
            "description": "Role given to a represented variable in the context of a long or wide data structure to identify the units associated to data points, and in dimensional and key value data structures to provide identifying fields for the instance values.",
            "allOf": [
                {
                    "$ref": "#/$defs/DataStructureComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "contains": {
                                "const": "cdi:IdentifierComponent"
                            },
                            "minItems": 1
                        }
                    },
                    "required": [
                        "@type",
                        "cdif:isDefinedBy_Variable"
                    ]
                }
            ]
        },
        "MeasureComponent": {
            "description": "Role given to a represented variable in the context of a data structure to hold the observed/derived values.",
            "allOf": [
                {
                    "$ref": "#/$defs/DataStructureComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "contains": {
                                "const": "cdi:MeasureComponent"
                            },
                            "minItems": 1
                        },
                        "cdif:name": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 1
                                }
                            ],
                            "description": "Human understandable name (linguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."
                        }
                    },
                    "required": [
                        "@type"
                    ]
                }
            ]
        },
        "AttributeComponent": {
            "description": "Role given to a represented variable in the context of a data structure to qualify observations or provide other types of supplementary information.",
            "allOf": [
                {
                    "$ref": "#/$defs/DataStructureComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "contains": {
                                "const": "cdi:AttributeComponent"
                            },
                            "minItems": 1
                        },
                        "cdif:qualifies": {
                            "type": "array",
                            "description": "The data structure components whose observations this attribute qualifies. Any component except another AttributeComponent, inline or by @id reference.",
                            "items": {
                                "anyOf": [
                                    {
                                        "$ref": "#/$defs/IdentifierComponent"
                                    },
                                    {
                                        "$ref": "#/$defs/MeasureComponent"
                                    },
                                    {
                                        "$ref": "#/$defs/DimensionComponent"
                                    },
                                    {
                                        "$ref": "#/$defs/VariableValueComponent"
                                    },
                                    {
                                        "$ref": "#/$defs/VariableDescriptorComponent"
                                    },
                                    {
                                        "$ref": "../objectReference/objectReferenceSchema.json"
                                    }
                                ]
                            },
                            "minItems": 1
                        }
                    },
                    "required": [
                        "@type"
                    ]
                }
            ]
        },
        "DimensionComponent": {
            "description": "Role given to a represented variable in the context of a dimensional data structure to identify the universes associated with data points. The variable acts as a field in the compound identifier (the key structure) to disambiguate the cells in the multi-dimensional \"cube\".  AG: references to the variables which are the components of a compound identifier, in which each variable is a single field - an axis - in a coordinate system addressing a location in a matrix. These variables are often categorical, but also commonly include time. Unlike other Components, they may be ordered using instances of cdi:ComponentPosition.",
            "allOf": [
                {
                    "$ref": "#/$defs/DataStructureComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "contains": {
                                "const": "cdi:DimensionComponent"
                            },
                            "minItems": 1
                        },
                        "cdif:categoricalAdditivity": {
                            "type": "boolean",
                            "default": false,
                            "description": "Indicates whether categories at a specific level can be combined to provide the value for their shared parent category. Value is True if categories can be added together (collapsed) to create higher-level categories. An example would be age categories: five-year age categories can be collapsed into 10-year age categories."
                        }
                    },
                    "required": [
                        "@type",
                        "cdif:isDefinedBy_Variable"
                    ]
                }
            ]
        },
        "VariableValueComponent": {
            "description": "Role given to a represented variable in the context of a data structure to record values of multiple variables.",
            "allOf": [
                {
                    "$ref": "#/$defs/DataStructureComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "contains": {
                                "const": "cdi:VariableValueComponent"
                            },
                            "minItems": 1
                        }
                    },
                    "required": [
                        "@type"
                    ]
                }
            ]
        },
        "VariableDescriptorComponent": {
            "description": "Role given to a represented variable in the context of a data structure to provide codes for variable identification.",
            "allOf": [
                {
                    "$ref": "#/$defs/DataStructureComponent"
                },
                {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "contains": {
                                "const": "cdi:VariableDescriptorComponent"
                            },
                            "minItems": 1
                        },
                        "cdif:isDefinedBy_DescriptorVariable": {
                            "description": "Variable that provides codes for variable identification in the context of a data structure. Descriptor Variables hold values which reference the logical variables in the data set, indicating which one the associated value in the corresponding Reference Variable is a measure/value for. Descriptor Variables are presentational variables found only in Long Data Sets. EA models this as its own association (connector 345) rather than a formal redefinition of the inherited isDefinedBy (connector 429), but CDIF treats it as a redefinition: the variable a VariableDescriptorComponent is a role of IS its DescriptorVariable, so the inherited property is disallowed below rather than left available.",
                            "$ref": "../../cdifDataType/cdifDescriptorVariable/cdifDescriptorVariableSchema.json"
                        },
                        "cdif:isDefinedBy_Variable": {
                            "not": {}
                        },
                        "cdi:refersTo": {
                            "$ref": "../objectReference/objectReferenceSchema.json"
                        }
                    },
                    "required": [
                        "@type",
                        "cdif:isDefinedBy_DescriptorVariable"
                    ]
                }
            ]
        }
    }
}
