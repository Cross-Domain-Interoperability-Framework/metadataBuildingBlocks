@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# The concept scheme itself.
# Derived from cdifConceptSchemeStructuredSchema.json required properties:
# @type, skos:prefLabel, skos:definition, skos:hasTopConcept.
cdifd:CDIFConceptSchemeShape a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:nodeKind sh:IRI ;
    sh:message "A CDIF concept scheme must have a resolvable IRI as @id." ;
    sh:property [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:message "skos:prefLabel is required on a CDIF concept scheme." ;
            sh:path skos:prefLabel ] ,
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:message "skos:definition is required on a CDIF concept scheme." ;
            sh:path skos:definition ] ,
        [ a sh:PropertyShape ;
            sh:class skos:Concept ;
            sh:minCount 1 ;
            sh:message "A concept scheme must declare at least one skos:hasTopConcept." ;
            sh:path skos:hasTopConcept ] .

# Concept inside a CDIF concept scheme ($defs/cdifConcept).
# Only @type and skos:prefLabel are required here -- deliberately weaker than
# CDIFCodelistConceptShape, which additionally requires skos:inScheme and
# skos:notation. A codelist is a concept scheme used as a value domain, so it
# constrains more; do not copy those two rules over without changing the schema.
cdifd:CDIFConceptSchemeConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:message "skos:prefLabel is required on every concept in a CDIF concept scheme." ;
            sh:path skos:prefLabel ] .

# When a catalog record (schema:subjectOf) is present, its dcterms:conformsTo
# must include the CDIF Concept Scheme profile URI.
cdifd:CDIFConceptSchemeConformsToShape a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <https://w3id.org/cdif/conceptscheme/1.1> ;
            sh:minCount 1 ;
            sh:message "A subjectOf catalog record on a CDIF concept scheme must include dcterms:conformsTo <https://w3id.org/cdif/conceptscheme/1.1>." ;
            sh:path dcterms:conformsTo ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes cdifd: ;
            sh:select """
                PREFIX schema: <http://schema.org/>
                PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
                PREFIX dcat: <http://www.w3.org/ns/dcat#>
                SELECT ?this WHERE {
                    ?scheme schema:subjectOf ?this .
                    ?scheme a skos:ConceptScheme .
                    ?this schema:additionalType ?at .
                    FILTER( ?at = dcat:CatalogRecord || STR(?at) = "dcat:CatalogRecord" )
                }
            """ ] .
