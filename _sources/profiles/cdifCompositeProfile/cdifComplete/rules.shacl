@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix cdi:        <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/>.
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# CDIFcomplete profile: composes cdifCore, cdifDiscovery, cdifDataDescription,
# cdifDataStructure, cdifManifest, and cdifProvenance.
# Validation rules for each component are in their respective
# rules.shacl files; this file adds the profile-level conformance
# check and any cross-cutting constraints specific to the complete profile.

# Datasets at the complete profile level should have provenance,
# data description variables, and distribution.
cdifd:CDIFCompleteDatasetShape
	a sh:NodeShape ;
	sh:target [
	  a sh:SPARQLTarget ;
    sh:select """
       PREFIX schema: <http://schema.org/>
            SELECT ?this
            WHERE {
              ?this a schema:Dataset .
              MINUS {
                ?this schema:about ?x .
                ?this schema:additionalType ?at .
                FILTER( ?at = <http://www.w3.org/ns/dcat#CatalogRecord> || STR(?at) = "dcat:CatalogRecord" )
              }
            }
          """ ;
	] ;
	sh:property [
		sh:path prov:wasGeneratedBy ;
		sh:minCount 1 ;
		sh:severity sh:Warning ;
		sh:message "A CDIFcomplete dataset should include provenance (prov:wasGeneratedBy)." ;
	] ;
	sh:property [
		sh:path schema:variableMeasured ;
		sh:minCount 1 ;
		sh:severity sh:Warning ;
		sh:message "A CDIFcomplete dataset should describe its variables (schema:variableMeasured)." ;
	] ;
	sh:property [
		sh:path schema:distribution ;
		sh:minCount 1 ;
		sh:severity sh:Warning ;
		sh:message "A CDIFcomplete dataset should have at least one distribution." ;
	] ;
	.

# The core/discovery/data_description/... profile pins a record must declare are
# NOT restated here. Each composed module carries its own
# cdifd:CDIF<Profile>ConformsToShape in its rules.shacl, which travels with the
# $ref graph into this bundle, and cdifCore's cdifd:metadataProfileProperty pins
# core. This file used to redeclare cdifd:metadataProfileProperty with the whole
# set: that is not an override in SHACL -- six files declared that one URI -- and
# it only added a second finding per URI, under a message that named the wrong
# version. Measured: deleting it leaves every required URI still flagged.

