@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/>.
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@prefix xas: <https://w3id.org/cdif/xas/> .
@base <https://www.ogc.org/rules/template/> .


cdifd:xasFacilityNode
	a sh:NodeShape;
	    sh:target [
	  a sh:SPARQLTarget ;
      sh:select  """
      PREFIX schema: <http://schema.org/>
      PREFIX xas: <https://w3id.org/cdif/xas/>
      SELECT DISTINCT ?this
        WHERE {
          ?this a schema:Place .
          # Transition: the NeXus base class is preferred, the retired xas:facility
          # is still accepted. Both are selected -- a target matching only the new
          # IRI would leave old-style facilities unselected, and an unfired shape
          # reports zero violations exactly like a passing one.
          VALUES ?facilityType {
            <https://manual.nexusformat.org/classes/base_classes/NXsource.html>
            xas:facility
          }
          ?this schema:additionalType ?facilityType .
          }""";
	] ;
    # This shape asserts nothing about schema:additionalType, deliberately. Its
    # target selects nodes BY that value, so any constraint on it here could never
    # fail -- measured 2026-09-27, a facility with schema:additionalType removed
    # conformed with zero violations because it was simply never selected. The
    # requirement is enforced by cdifd:xasAnalysisLocationClassified below, whose
    # target establishes "this is an XAS facility" WITHOUT reading the property
    # under test, and by the JSON Schema enum in schema.yaml.
    sh:property [
      sh:path schema:name ;
      sh:minCount 1 ;
      sh:datatype xsd:string ;
	  sh:minLength 3 ;
      sh:message "A facility must have a name with at least 3 characters."
    ] .


# A Place used as the location of an XAS analysis MUST be classified as a facility.
#
# The point of this shape is that its target does not mention schema:additionalType
# on ?this: context comes from the inbound schema:location of an activity classified
# xas:analysisevent, which is a term this retirement does not touch. So the
# classification is genuinely under test here, and a location missing it is a
# violation rather than a node that quietly falls outside every target.
cdifd:xasAnalysisLocationClassified
	a sh:NodeShape;
	    sh:target [
	  a sh:SPARQLTarget ;
      sh:select  """
      PREFIX schema: <http://schema.org/>
      PREFIX xas: <https://w3id.org/cdif/xas/>
      SELECT DISTINCT ?this
        WHERE {
          ?activity schema:additionalType xas:analysisevent .
          ?activity schema:location ?this .
          ?this a schema:Place .
          }""";
	] ;
    # sh:or, not sh:in: additionalType carries other classifications alongside, so
    # the requirement is "at least one value is the facility class". One branch per
    # accepted term -- the NeXus base class is preferred, the retired xas:facility
    # is accepted for the transition. Drop the second branch when cdifnexmetadata
    # and XAS-CDIF emit the NeXus form.
    sh:or (
      [ sh:path schema:additionalType ;
        sh:hasValue <https://manual.nexusformat.org/classes/base_classes/NXsource.html> ]
      [ sh:path schema:additionalType ;
        sh:hasValue xas:facility ]
    ) ;
    sh:message "A Place used as the location of an XAS analysis must have schema:additionalType the NeXus NXsource base class (xas:facility is accepted during the transition)." .
