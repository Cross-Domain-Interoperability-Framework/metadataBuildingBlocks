@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/>.
@prefix cdifd: <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .


cdifd:instrumentNode
	a sh:NodeShape;
	    sh:target [
	  a sh:SPARQLTarget ;
      sh:select  """
      PREFIX schema: <http://schema.org/>
      SELECT DISTINCT ?this
        WHERE {
          ?s schema:instrument ?this .
          FILTER (isIRI(?this) || isBlank(?this))
          }""";
	] ;

	# -- REQUIRED (Violation) --

    sh:property [
      sh:path schema:name ;
      sh:minCount 1 ;
      sh:datatype xsd:string ;
      sh:minLength 3 ;
      sh:severity sh:Violation ;
      sh:message "An instrument must have a name with at least 3 characters."
    ] ;

	# -- RECOMMENDED (Warning) --

    # The classification requirement moved to cdifd:instrumentClassified at the
    # foot of this file, which accepts schema:additionalType as well. Measured
    # 2026-11-06: of 21 instrument nodes across mBB's examples, 14 carried
    # schema:additionalType only and 3 schema:category only, so asking for
    # schema:category alone reported 17 of 21 instruments as unclassified while
    # their classification sat in the other property.

	# -- INFORMATIONAL (Info) --

    sh:property [
      sh:path schema:identifier ;
      sh:severity sh:Info ;
      sh:message "An instrument should have an identifier (schema:identifier)."
    ] ;
    sh:property [
      sh:path schema:description ;
      sh:datatype xsd:string ;
      sh:severity sh:Info ;
      sh:message "An instrument should have a text description."
    ] ;
    sh:property [
      sh:path schema:manufacturer ;
      sh:severity sh:Info ;
      sh:message "An instrument should identify its manufacturer (schema:manufacturer)."
    ] ;
    sh:property [
      sh:path schema:model ;
      sh:severity sh:Info ;
      sh:message "An instrument should specify its product model (schema:model)."
    ] ;
    sh:property [
      sh:path schema:owner ;
      sh:severity sh:Info ;
      sh:message "An instrument should identify its owner (schema:owner)."
    ] ;
    sh:property [
      sh:path schema:contributor ;
      sh:severity sh:Info ;
      sh:message "An instrument should identify contributors with roles (e.g. operator, custodian, PI)."
    ] ;
    sh:property [
      sh:path schema:additionalType ;
      sh:severity sh:Info ;
      sh:message "An instrument should have a domain-specific type URI (schema:additionalType)."
    ] ;
    sh:property [
      sh:path schema:url ;
      sh:severity sh:Info ;
      sh:message "An instrument should have a landing page URL (schema:url)."
    ] ;
    sh:property [
      sh:path schema:validFrom ;
      sh:severity sh:Info ;
      sh:message "An instrument should have a commissioned date (schema:validFrom)."
    ] .


# Either property satisfies this: schema:category is schema.org's own slot, and
# schema:additionalType is what CDIF's XAS and geochem records actually use,
# carrying a controlled-vocabulary IRI such as xas:xraymonochromator or
# nxs:base_classes/NXinstrument.html. A separate NodeShape rather than an sh:or
# on cdifd:instrumentNode, because sh:severity on that shape would apply to its
# sh:Violation name rule too.
cdifd:instrumentClassified
	a sh:NodeShape;
	sh:target [
	  a sh:SPARQLTarget ;
      sh:select  """
      PREFIX schema: <http://schema.org/>
      SELECT DISTINCT ?this
        WHERE {
          ?s schema:instrument ?this .
          FILTER (isIRI(?this) || isBlank(?this))
          }""";
	] ;
	sh:or (
	  [ sh:property [ sh:path schema:category ; sh:minCount 1 ] ]
	  [ sh:property [ sh:path schema:additionalType ; sh:minCount 1 ] ]
	) ;
	sh:severity sh:Warning ;
	sh:message "An instrument should carry a classification from a controlled vocabulary, in either schema:category or schema:additionalType." ;
	.
